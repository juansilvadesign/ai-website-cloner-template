---
import BaseLayout from "../../clones/fesn/layouts/BaseLayout.astro";
import StudentCardFound from "../../clones/fesn/components/StudentCardFound.astro";
import type { StudentCard } from "../../clones/fesn/types/fesn";

/**
 * Found state of `/student-card`.
 *
 * The target picks between two server-rendered states by resolving `?documento=` against a
 * live lookup. This clone is a STATIC build with no backend (explicitly out of scope), and
 * `Astro.url.searchParams` is empty at build time — so the two states are emitted as two
 * routes instead: this one, and `/student-card-nao-encontrada`.
 *
 * All credential values are MOCK. The live payload is personally identifying and is never
 * reproduced here.
 */
const mockCard: StudentCard = {
  name: "ESTUDANTE MODELO",
  cieCode: "FESN2026X",
  institution: "IFRS",
  course: "GERENCIAMENTO DE RESÍDUOS",
  courseType: "TÉCNICO",
  cpf: "000.000.000-00",
  birthDate: "01/01/2000",
  validUntil: "31/03/2027",
  year: "2026",
  photoSrc: "/clones/fesn/images/mock-student-photo.svg",
  qrSrc: "/clones/fesn/images/mock-qr.svg",
};
---

<BaseLayout
  title="FESN | Carteirinha Estudantil"
  description="Consulte e solicite sua carteirinha estudantil digital com validação por QR Code em ambiente oficial da FESN."
  canonical="https://carteirinha.fesn.org.br/student-card"
>
  <StudentCardFound card={mockCard} />
</BaseLayout>
