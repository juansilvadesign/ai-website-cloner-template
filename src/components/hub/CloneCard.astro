---
import type { Clone } from "../../data/clones/types";

interface Props {
  clone: Clone;
}

const { clone } = Astro.props;
const { meta, routes } = clone;

const isBuilt = routes.length > 0;
const primaryRoute = routes[0]?.path;
const sourceLabel = meta.sourceUrl.replace(/^https?:\/\//, "");

// "Use as template" needs something to eject. A `build: "none"` clone has a
// design system and no pages, which is exactly what `eject-clone.mjs` refuses.
const defaultTarget = `../${meta.slug}-clone`;
const ejectCommand = `npm run eject -- ${meta.slug} ${defaultTarget}`;
---

<article class="card" id={`clone-${meta.slug}`}>
  <div class="cover" data-empty={!meta.cover}>
    {
      meta.cover ? (
        <img src={meta.cover} alt="" width="640" height="360" loading="lazy" />
      ) : (
        <svg
          class="cover-glyph"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="1.25"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
        >
          <circle cx="13.5" cy="6.5" r="2.5" />
          <circle cx="17.5" cy="14" r="2.5" />
          <circle cx="8.5" cy="7.5" r="2.5" />
          <circle cx="6.5" cy="12.5" r="2.5" />
          <path
            d="M12 2a10 10 0 0 0 0 20c.94 0 1.7-.76 1.7-1.7v-.4c0-.94.76-1.7 1.7-1.7H17a5 5 0 0 0 5-5c0-5.52-4.48-10-10-10Z"
          />
        </svg>
      )
    }
    <span class="badge" data-build={meta.build}>
      {isBuilt ? `${routes.length} ${routes.length === 1 ? "route" : "routes"}` : "design system only"}
    </span>
  </div>

  <div class="body">
    <h2 class="title">
      {
        primaryRoute ? (
          <a href={primaryRoute}>{meta.name}</a>
        ) : (
          meta.name
        )
      }
    </h2>

    <p class="desc">{meta.description}</p>

    <a class="source" href={meta.sourceUrl} rel="noreferrer noopener nofollow" target="_blank">
      {sourceLabel}
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <path d="M7 17 17 7M17 7H9M17 7v8" />
      </svg>
    </a>

    {
      isBuilt ? (
        <ul class="routes">
          {routes.map((route) => (
            <li>
              <a href={route.path}>
                <span class="route-label">{route.label}</span>
                <code>{route.path}</code>
              </a>
              {route.note && <p class="route-note">{route.note}</p>}
            </li>
          ))}
        </ul>
      ) : (
        <p class="no-page">
          No page was built for this target. Its design system is emitted and
          namespaced; add routes under <code>src/pages/{meta.slug}/</code> to
          build one.
        </p>
      )
    }

    <footer class="meta">
      <code class="ds">design-systems/{meta.slug}</code>
      <span class="date">cloned {meta.clonedAt}</span>
    </footer>

    {
      meta.tags.length > 0 && (
        <ul class="tags">
          {meta.tags.map((tag) => (
            <li>{tag}</li>
          ))}
        </ul>
      )
    }

    {/* "Use as template" — copies this clone out as a standalone Astro project.
        `import.meta.env.DEV` picks the variant at build time, so the static hub
        ships the copy-the-command fallback and no fetch code at all. */}
    {
      isBuilt && (
        <div class="eject" data-slug={meta.slug}>
          {import.meta.env.DEV ? (
            <>
              <button type="button" class="eject-btn" data-eject-toggle aria-expanded="false">
                Use as template
              </button>

              <form class="eject-form" hidden>
                <label>
                  Target folder
                  <input
                    type="text"
                    name="targetDir"
                    value={defaultTarget}
                    spellcheck="false"
                    autocomplete="off"
                    required
                  />
                </label>
                <div class="eject-actions">
                  <button type="submit" class="eject-btn eject-btn--go">
                    Eject
                  </button>
                  <button type="button" class="eject-link" data-eject-cancel>
                    Cancel
                  </button>
                </div>
                <p class="eject-hint">
                  Relative to the repo root. Refuses a folder that already has files —
                  use the CLI with <code>--force</code> to override.
                </p>
              </form>
            </>
          ) : (
            <button type="button" class="eject-btn" data-eject-copy={ejectCommand}>
              Copy eject command
            </button>
          )}

          <p class="eject-status" role="status" aria-live="polite" />
        </div>
      )
    }
  </div>
</article>

<script>
  // Delegated listeners covering every card on the hub.
  //
  // The dev-only half is wrapped in `import.meta.env.DEV`, which Vite replaces
  // with a literal `false` at build time so the whole block is dropped. Without
  // that wrapper the static hub still inlines the `/api/eject` fetch — dead code
  // that can never reach an endpoint, describing a capability the page does not
  // have.
  const status = (root: Element, message: string, tone: "" | "ok" | "err" = "") => {
    const el = root.querySelector<HTMLParagraphElement>(".eject-status");
    if (!el) return;
    el.textContent = message;
    el.dataset.tone = tone;
  };

  // Static build: copy the CLI command instead.
  document.addEventListener("click", async (event) => {
    const target = event.target;
    if (!(target instanceof Element)) return;

    const copyBtn = target.closest<HTMLButtonElement>("[data-eject-copy]");
    if (!copyBtn) return;

    const command = copyBtn.dataset.ejectCopy ?? "";
    const root = copyBtn.closest(".eject");
    if (!root) return;
    try {
      await navigator.clipboard.writeText(command);
      status(root, "Copied — run it from the repo root.", "ok");
    } catch {
      status(root, command, "");
    }
  });

  if (import.meta.env.DEV) {
    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!(target instanceof Element)) return;

      const toggle = target.closest<HTMLButtonElement>("[data-eject-toggle]");
      if (toggle) {
        const root = toggle.closest(".eject");
        const form = root?.querySelector<HTMLFormElement>(".eject-form");
        if (!root || !form) return;
        const opening = form.hidden;
        form.hidden = !opening;
        toggle.setAttribute("aria-expanded", String(opening));
        if (opening) form.querySelector("input")?.focus();
        else status(root, "");
        return;
      }

      const cancel = target.closest<HTMLButtonElement>("[data-eject-cancel]");
      if (cancel) {
        const root = cancel.closest(".eject");
        const form = root?.querySelector<HTMLFormElement>(".eject-form");
        if (!root || !form) return;
        form.hidden = true;
        root.querySelector("[data-eject-toggle]")?.setAttribute("aria-expanded", "false");
        status(root, "");
      }
    });

    document.addEventListener("submit", async (event) => {
      const form = event.target;
      if (!(form instanceof HTMLFormElement) || !form.classList.contains("eject-form")) return;
      event.preventDefault();

      const root = form.closest<HTMLElement>(".eject");
      const slug = root?.dataset.slug;
      if (!root || !slug) return;

      const input = form.querySelector<HTMLInputElement>('input[name="targetDir"]');
      const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]');
      const targetDir = input?.value.trim() ?? "";
      if (!targetDir) return;

      if (submit) submit.disabled = true;
      status(root, `Ejecting ${slug}…`);

      try {
        const response = await fetch("/api/eject", {
          method: "POST",
          headers: { "content-type": "application/json", "x-eject-request": "1" },
          body: JSON.stringify({ slug, targetDir }),
        });
        const result = await response.json();

        if (!response.ok || !result.ok) {
          status(root, result.error ?? `Failed with ${response.status}.`, "err");
        } else {
          const { counts, targetDir: written } = result;
          status(
            root,
            `Ejected to ${written} — ${counts.rewritten + counts.copied + counts.generated} files, ` +
              `${counts.references} references rewritten. Run npm i && npm run dev there.`,
            "ok",
          );
          form.hidden = true;
          root.querySelector("[data-eject-toggle]")?.setAttribute("aria-expanded", "false");
        }
      } catch (error) {
        status(root, error instanceof Error ? error.message : "Request failed.", "err");
      } finally {
        if (submit) submit.disabled = false;
      }
    });
  }
</script>

<style>
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    background: var(--hub-surface);
    border: 1px solid var(--hub-border);
    border-radius: var(--hub-radius);
    box-shadow: var(--hub-shadow);
    transition:
      box-shadow 160ms ease,
      border-color 160ms ease,
      transform 160ms ease;
  }

  .card:hover {
    border-color: color-mix(in oklab, var(--hub-accent) 32%, var(--hub-border));
    box-shadow: var(--hub-shadow-lift);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .card,
    .card:hover {
      transform: none;
      transition: none;
    }
  }

  /* ─── Cover ─── */
  .cover {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--hub-surface-2);
    border-bottom: 1px solid var(--hub-border);
  }

  /* Absolutely positioned so the 16/9 box holds whatever the cover's intrinsic
     ratio is. A percentage height cannot resolve against an aspect-ratio-derived
     height, so a `height: 100%` image would fall back to its natural ratio and
     stretch the box — the FESN hero is roughly square. */
  .cover img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  .cover[data-empty="true"] {
    display: grid;
    place-items: center;
  }

  .cover-glyph {
    width: 44px;
    height: 44px;
    color: var(--hub-meta);
  }

  .badge {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 3px 9px;
    background: color-mix(in oklab, var(--hub-surface) 88%, transparent);
    border: 1px solid var(--hub-border);
    border-radius: 999px;
    font-size: 11.5px;
    font-weight: 500;
    letter-spacing: 0.01em;
    color: var(--hub-muted);
    backdrop-filter: blur(6px);
  }

  .badge[data-build="none"] {
    color: var(--hub-accent);
    background: var(--hub-accent-soft);
    border-color: color-mix(in oklab, var(--hub-accent) 26%, transparent);
  }

  /* ─── Body ─── */
  .body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: 10px;
    padding: 16px 18px 18px;
  }

  .title {
    font-size: 16.5px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .title a {
    text-decoration: none;
  }

  .title a:hover {
    color: var(--hub-accent);
  }

  .desc {
    font-size: 13.5px;
    color: var(--hub-muted);
    text-wrap: pretty;
  }

  .source {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    font-family: var(--hub-mono);
    font-size: 12px;
    color: var(--hub-meta);
    text-decoration: none;
  }

  .source:hover {
    color: var(--hub-accent);
    text-decoration: underline;
  }

  .source svg {
    width: 12px;
    height: 12px;
  }

  /* ─── Routes ─── */
  .routes {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--hub-border);
    padding-top: 10px;
  }

  /* Label above path rather than side-by-side: route slugs are arbitrarily long
     (`/fesn/student-card-nao-encontrada/`) and a single row forces the label to
     wrap into a ragged column. */
  .routes > li > a {
    display: flex;
    flex-direction: column;
    gap: 1px;
    padding: 5px 7px;
    margin-inline: -7px;
    border-radius: var(--hub-radius-sm);
    font-size: 13px;
    text-decoration: none;
  }

  .routes > li > a:hover {
    background: var(--hub-surface-2);
  }

  .routes > li > a:hover .route-label {
    color: var(--hub-accent);
  }

  .route-label {
    font-weight: 500;
  }

  .routes code {
    font-family: var(--hub-mono);
    font-size: 11.5px;
    color: var(--hub-meta);
    overflow-wrap: anywhere;
  }

  .route-note {
    padding: 0 7px 4px;
    margin-inline: -7px;
    font-size: 11.5px;
    line-height: 1.45;
    color: var(--hub-meta);
    text-wrap: pretty;
  }

  .no-page {
    margin-top: 4px;
    padding-top: 10px;
    border-top: 1px solid var(--hub-border);
    font-size: 12.5px;
    line-height: 1.5;
    color: var(--hub-muted);
    text-wrap: pretty;
  }

  .no-page code {
    font-family: var(--hub-mono);
    font-size: 11.5px;
  }

  /* ─── Meta ─── */
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    margin-top: auto;
    padding-top: 12px;
    font-size: 11.5px;
    color: var(--hub-meta);
  }

  .ds {
    font-family: var(--hub-mono);
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 5px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags li {
    padding: 2px 7px;
    background: var(--hub-surface-2);
    border-radius: 999px;
    font-size: 11px;
    color: var(--hub-muted);
  }

  /* ─── Use as template ─── */
  .eject {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 12px;
    padding-top: 12px;
    border-top: 1px solid var(--hub-border);
  }

  .eject-btn {
    align-self: flex-start;
    padding: 5px 11px;
    background: var(--hub-surface-2);
    border: 1px solid var(--hub-border);
    border-radius: var(--hub-radius-sm);
    font: inherit;
    font-size: 12.5px;
    font-weight: 500;
    color: var(--hub-fg);
    cursor: pointer;
    transition:
      background-color 140ms ease,
      border-color 140ms ease,
      color 140ms ease;
  }

  .eject-btn:hover {
    background: var(--hub-accent-soft);
    border-color: color-mix(in oklab, var(--hub-accent) 32%, var(--hub-border));
    color: var(--hub-accent);
  }

  .eject-btn:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .eject-btn--go {
    background: var(--hub-accent);
    border-color: var(--hub-accent);
    color: var(--hub-bg);
  }

  .eject-btn--go:hover {
    background: var(--hub-accent);
    border-color: var(--hub-accent);
    color: var(--hub-bg);
    filter: brightness(1.08);
  }

  .eject-form {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .eject-form label {
    display: flex;
    flex-direction: column;
    gap: 4px;
    font-size: 11.5px;
    color: var(--hub-meta);
  }

  .eject-form input {
    padding: 6px 9px;
    background: var(--hub-bg);
    border: 1px solid var(--hub-border);
    border-radius: var(--hub-radius-sm);
    font-family: var(--hub-mono);
    font-size: 12px;
    color: var(--hub-fg);
  }

  .eject-form input:focus-visible {
    outline: 2px solid var(--hub-accent);
    outline-offset: 1px;
  }

  .eject-actions {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .eject-link {
    padding: 0;
    background: none;
    border: 0;
    font: inherit;
    font-size: 12px;
    color: var(--hub-meta);
    text-decoration: underline;
    cursor: pointer;
  }

  .eject-link:hover {
    color: var(--hub-fg);
  }

  .eject-hint {
    font-size: 11px;
    line-height: 1.5;
    color: var(--hub-meta);
    text-wrap: pretty;
  }

  .eject-hint code {
    font-family: var(--hub-mono);
  }

  .eject-status:empty {
    display: none;
  }

  .eject-status {
    font-size: 11.5px;
    line-height: 1.5;
    color: var(--hub-muted);
    overflow-wrap: anywhere;
    text-wrap: pretty;
  }

  .eject-status[data-tone="ok"] {
    color: var(--hub-accent);
  }

  .eject-status[data-tone="err"] {
    color: #d4183d;
  }
</style>
