---
/** "Como tirar sua carteirinha" on `/vendas`. Spec: docs/research/components/vendas-steps.spec.md */
import type { StepCard } from "../types/fesn";

const steps: StepCard[] = [
  {
    eyebrow: "Passo 1",
    title: "Inicie seu cadastro",
    body: "Informe seus dados principais e aceite os termos para registrar seu pedido com segurança.",
  },
  {
    eyebrow: "Passo 2",
    title: "Complete o cadastro",
    body: "Preencha os dados acadêmicos e envie foto e comprovante estudantil diretamente no checkout.",
  },
  {
    eyebrow: "Passo 3",
    title: "Análise e liberação",
    body: "A equipe oficial da FESN conclui a validação para liberar a carteirinha digital para uso.",
  },
];
---

<section class="section" id="como-funciona">
  <h2>Como tirar sua carteirinha de estudante online</h2>
  <div class="grid">
    {
      steps.map((s) => (
        <article class="card">
          <div class="inner">
            <p class="eyebrow">{s.eyebrow}</p>
            <h3>{s.title}</h3>
            <p class="body">{s.body}</p>
          </div>
        </article>
      ))
    }
  </div>
</section>

<style>
  .section {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 var(--container-gutter-phone) var(--section-y-tablet);
    scroll-margin-top: var(--space-6);
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 32px;
    color: var(--fg);
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-5);
    margin-top: var(--space-8);
  }

  .card {
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--elev-flat);
  }

  .inner {
    padding: var(--space-6);
  }

  .eyebrow {
    margin-bottom: var(--space-2);
    font-size: var(--text-xs);
    font-weight: 600;
    line-height: 16px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h3 {
    margin-bottom: var(--space-2);
    font-size: var(--text-base);
    font-weight: 600;
    line-height: 24px;
    color: #0a0a0a;
  }

  .body {
    font-size: var(--text-sm);
    line-height: 20px;
    color: var(--muted);
  }

  @media (min-width: 640px) {
    .section {
      padding-inline: var(--container-gutter-tablet);
    }
    h2 {
      font-size: var(--text-2xl);
      line-height: 36px;
    }
  }

  @media (min-width: 768px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .section {
      padding-bottom: var(--section-y-desktop);
    }
  }
</style>
