---
import type { CaseStudy } from "../data/site";
import { caseStudies, siteRoute } from "../data/site";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  caseStudy: CaseStudy;
}

const { caseStudy } = Astro.props;
const nextCase = caseStudies[caseStudy.nextSlug];
---

<main class="case-study">
  <section class="case-study__hero" aria-labelledby="case-title">
    <SiteHeader tone="light" overlay />
    <img class="case-study__hero-image" src={caseStudy.heroImage} alt={`${caseStudy.title} project cover`} />
    <div class="case-study__hero-veil"></div>
    <div class="case-study__hero-copy">
      <p>{caseStudy.number} &gt; CASE STUDY</p>
      <h1 id="case-title">{caseStudy.title}</h1>
      <p class="case-study__subtitle">{caseStudy.subtitle}</p>
    </div>
  </section>

  <section class="case-study__statement" aria-labelledby="statement-title">
    <p>{caseStudy.number} &gt; {caseStudy.title}</p>
    <h2 id="statement-title">{caseStudy.statement}</h2>
  </section>

  <section class="case-study__brief" aria-label="Project brief">
    <div>
      <p>CLIENT</p>
      <strong>{caseStudy.client}</strong>
    </div>
    <div>
      <p>DURATION</p>
      <strong>{caseStudy.duration}</strong>
    </div>
    <div>
      <p>ROLE</p>
      <strong>{caseStudy.role}</strong>
    </div>
  </section>

  <section class="case-study__reading">
    <div class="case-study__reading-label">THE BRIEF</div>
    <p>{caseStudy.brief}</p>
  </section>

  <section class="case-study__media" aria-label={`${caseStudy.title} design artefacts`}>
    {caseStudy.media.map((source, index) => (
      <figure class:list={["case-study__figure", { "case-study__figure--wide": index % 3 === 0 }]}>
        <img src={source} alt={caseStudy.mediaAlt[index]} loading={index === 0 ? "eager" : "lazy"} />
      </figure>
    ))}
  </section>

  <section class="case-study__context">
    <div>
      <p>CONTEXT</p>
      <h2>Research to frame a more meaningful experience.</h2>
    </div>
    <p>{caseStudy.context}</p>
  </section>

  <section class="case-study__outcome">
    <p>OUTCOME</p>
    <h2>{caseStudy.outcome}</h2>
  </section>

  <a class="case-study__next" href={siteRoute(`${nextCase.slug}/`)}>
    <span>NEXT CASE</span>
    <strong>{nextCase.number} &gt; {nextCase.title}</strong>
    <span aria-hidden="true">↘</span>
  </a>
</main>

<style>
  .case-study {
    color: var(--surface);
    background: var(--bg);
  }

  .case-study__hero {
    position: relative;
    min-height: min(100vh, 55rem);
    overflow: hidden;
    background: var(--bg);
  }

  .case-study__hero-image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-study__hero-veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, color-mix(in srgb, var(--bg), transparent 4%), color-mix(in srgb, var(--bg), transparent 64%));
  }

  .case-study__hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100%, var(--container-max));
    min-height: inherit;
    flex-direction: column;
    justify-content: end;
    margin-inline: auto;
    padding: calc(var(--section-y-desktop) + 5rem) var(--container-gutter-desktop) var(--section-y-desktop);
  }

  .case-study__hero-copy > p:first-child,
  .case-study__statement > p,
  .case-study__brief p,
  .case-study__context > div > p,
  .case-study__outcome > p,
  .case-study__reading-label,
  .case-study__next > span:first-child {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.09em;
  }

  .case-study h1 {
    max-width: 70rem;
    margin: var(--space-5) 0 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 9vw, 8.5rem);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 0.86;
  }

  .case-study__subtitle {
    max-width: 38rem;
    margin: var(--space-6) 0 0;
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 500;
    line-height: 1.4;
  }

  .case-study__statement {
    padding: var(--section-y-desktop) var(--container-gutter-desktop);
    color: var(--fg);
    background: var(--surface);
  }

  .case-study__statement > p {
    color: var(--fg-2);
  }

  .case-study__statement h2,
  .case-study__outcome h2 {
    max-width: 68rem;
    margin: var(--space-5) 0 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 5vw, 5.3rem);
    font-weight: 300;
    line-height: var(--leading-tight);
  }

  .case-study__brief {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-8);
    padding: var(--section-y-tablet) var(--container-gutter-desktop);
    background: var(--bg);
  }

  .case-study__brief p,
  .case-study__context > div > p,
  .case-study__outcome > p {
    color: var(--accent);
  }

  .case-study__brief strong {
    display: block;
    max-width: 22rem;
    margin-top: var(--space-4);
    color: var(--surface);
    font-family: var(--font-display);
    font-size: var(--text-lg);
    font-weight: 400;
    line-height: 1.35;
  }

  .case-study__reading {
    display: grid;
    grid-template-columns: minmax(10rem, 0.3fr) minmax(0, 0.7fr);
    gap: var(--space-8);
    padding: var(--section-y-desktop) max(var(--container-gutter-desktop), calc((100vw - var(--container-max)) / 2 + var(--container-gutter-desktop)));
    color: var(--fg);
    background: var(--surface-warm);
  }

  .case-study__reading-label {
    color: var(--fg-2);
  }

  .case-study__reading > p {
    max-width: 52rem;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
    font-weight: 300;
    line-height: 1.3;
  }

  .case-study__media {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-4);
    padding: var(--space-4);
    background: var(--bg);
  }

  .case-study__figure {
    min-height: 28rem;
    margin: 0;
    overflow: hidden;
    background: var(--fg-2);
  }

  .case-study__figure--wide {
    grid-column: 1 / -1;
    min-height: 40rem;
  }

  .case-study__figure img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .case-study__context {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: var(--section-y-tablet);
    padding: var(--section-y-desktop) var(--container-gutter-desktop);
  }

  .case-study__context h2 {
    max-width: 28rem;
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 3vw, var(--text-3xl));
    font-weight: 300;
    line-height: 1.2;
  }

  .case-study__context > p {
    max-width: 44rem;
    margin: 0;
    color: var(--muted);
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: var(--leading-body);
  }

  .case-study__outcome {
    padding: var(--section-y-desktop) var(--container-gutter-desktop);
    color: var(--fg);
    background: var(--accent);
  }

  .case-study__outcome > p {
    color: var(--fg);
  }

  .case-study__next {
    display: grid;
    gap: var(--space-4);
    padding: var(--section-y-tablet) var(--container-gutter-desktop);
    color: var(--surface);
    text-decoration: none;
    background: var(--bg);
  }

  .case-study__next strong {
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 5vw, 5rem);
    font-weight: 300;
    line-height: var(--leading-tight);
    transition: color var(--motion-base) var(--ease-standard);
  }

  .case-study__next > span:last-child {
    color: var(--accent);
    font-size: var(--text-3xl);
  }

  .case-study__next:hover strong {
    color: var(--accent);
  }

  @media (max-width: 48rem) {
    .case-study__hero {
      min-height: 39rem;
    }

    .case-study__hero-veil {
      background: linear-gradient(0deg, color-mix(in srgb, var(--bg), transparent 4%), color-mix(in srgb, var(--bg), transparent 62%));
    }

    .case-study__hero-copy,
    .case-study__statement,
    .case-study__brief,
    .case-study__context,
    .case-study__outcome,
    .case-study__next {
      padding-inline: var(--container-gutter-phone);
    }

    .case-study__hero-copy {
      padding-top: calc(var(--section-y-phone) + 5rem);
      padding-bottom: var(--section-y-phone);
    }

    .case-study h1 {
      font-size: clamp(var(--text-3xl), 16vw, 5rem);
    }

    .case-study__statement,
    .case-study__reading,
    .case-study__context,
    .case-study__outcome {
      padding-block: var(--section-y-phone);
    }

    .case-study__brief,
    .case-study__reading,
    .case-study__context {
      grid-template-columns: 1fr;
      gap: var(--space-8);
    }

    .case-study__brief {
      gap: var(--space-6);
      padding-block: var(--section-y-phone);
    }

    .case-study__reading {
      padding-inline: var(--container-gutter-phone);
    }

    .case-study__media {
      grid-template-columns: 1fr;
      gap: var(--space-3);
      padding: var(--space-3);
    }

    .case-study__figure,
    .case-study__figure--wide {
      min-height: 20rem;
      grid-column: auto;
    }

    .case-study__figure--wide {
      min-height: 26rem;
    }
  }
</style>
