---
import type { GalleryKey } from "../data/site";
import { galleries } from "../data/site";
import SiteHeader from "./SiteHeader.astro";

interface Props {
  gallery: GalleryKey;
}

const { gallery } = Astro.props;
const content = galleries[gallery];
---

<main class="gallery-page">
  <SiteHeader tone="dark" />
  <section class="gallery-page__intro" aria-labelledby="gallery-title">
    <p>{content.eyebrow}</p>
    <h1 id="gallery-title">{content.title}</h1>
    <p class="gallery-page__description">{content.description}</p>
  </section>
  <section class="gallery-page__grid" aria-label={content.title}>
    {content.images.map((source, index) => (
      <figure class:list={["gallery-page__item", `gallery-page__item--${(index % 6) + 1}`]}>
        <img src={source} alt={content.labels[index]} loading={index < 3 ? "eager" : "lazy"} />
        <figcaption>{String(index + 1).padStart(2, "0")} — {content.labels[index]}</figcaption>
      </figure>
    ))}
  </section>
</main>

<style>
  .gallery-page {
    min-height: 100vh;
    color: var(--fg);
    background: var(--surface);
  }

  .gallery-page__intro {
    max-width: 72rem;
    padding: var(--section-y-desktop) var(--container-gutter-desktop) var(--section-y-tablet);
  }

  .gallery-page__intro > p:first-child,
  .gallery-page figcaption {
    margin: 0;
    color: var(--fg-2);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.09em;
  }

  .gallery-page h1 {
    max-width: 64rem;
    margin: var(--space-5) 0 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 7vw, 7.3rem);
    font-weight: 300;
    letter-spacing: -0.055em;
    line-height: 0.9;
  }

  .gallery-page__description {
    max-width: 38rem;
    margin: var(--space-8) 0 0;
    color: var(--fg-2);
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: var(--leading-body);
  }

  .gallery-page__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--space-4);
    padding: 0 var(--container-gutter-desktop) var(--section-y-desktop);
  }

  .gallery-page__item {
    grid-column: span 6;
    margin: 0;
  }

  .gallery-page__item--1,
  .gallery-page__item--4 {
    grid-column: span 7;
  }

  .gallery-page__item--2,
  .gallery-page__item--5 {
    grid-column: span 5;
  }

  .gallery-page__item--3,
  .gallery-page__item--6 {
    grid-column: span 4;
  }

  .gallery-page__item img {
    width: 100%;
    height: clamp(16rem, 39vw, 42rem);
    object-fit: cover;
    background: var(--surface-warm);
  }

  .gallery-page__item--3 img,
  .gallery-page__item--6 img {
    height: clamp(14rem, 25vw, 26rem);
  }

  .gallery-page figcaption {
    margin-top: var(--space-3);
  }

  @media (max-width: 48rem) {
    .gallery-page__intro {
      padding: var(--section-y-phone) var(--container-gutter-phone) var(--space-12);
    }

    .gallery-page h1 {
      font-size: clamp(var(--text-3xl), 13vw, 4.5rem);
    }

    .gallery-page__grid {
      grid-template-columns: 1fr;
      gap: var(--space-6);
      padding: 0 var(--container-gutter-phone) var(--section-y-phone);
    }

    .gallery-page__item,
    .gallery-page__item--1,
    .gallery-page__item--2,
    .gallery-page__item--3,
    .gallery-page__item--4,
    .gallery-page__item--5,
    .gallery-page__item--6 {
      grid-column: auto;
    }

    .gallery-page__item img,
    .gallery-page__item--3 img,
    .gallery-page__item--6 img {
      height: 25rem;
    }
  }
</style>
