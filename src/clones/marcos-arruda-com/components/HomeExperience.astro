---
import { companyMarks, homeProjects } from "../data/site";
import SiteHeader from "./SiteHeader.astro";
---

<main>
  <section class="home-hero" aria-labelledby="home-title">
    <img class="home-hero__portrait" src="/clones/marcos-arruda-com/images/home-portrait.jpg" alt="Marcos Arruda holding a pocket watch" />
    <div class="home-hero__content">
      <p class="home-hero__name" id="home-title">MARCOS ARRUDA</p>
      <h1>
        Product and service designer<br />
        who believes innovation is a<br />
        <span>collaborative journey.</span>
      </h1>
      <a href="#work" class="home-hero__explore">Explore work <span aria-hidden="true">↓</span></a>
    </div>
  </section>

  <SiteHeader tone="dark" />

  <section class="home-fashion" aria-labelledby="fashion-title">
    <div class="home-fashion__copy">
      <p>RECENT WORK</p>
      <h2 id="fashion-title">Making the circular future of fashion tangible.</h2>
      <a href="/marcos-arruda-com/case1/">View project <span aria-hidden="true">↗</span></a>
    </div>
    <video class="home-fashion__video" autoplay muted loop playsinline poster="/clones/marcos-arruda-com/images/home-fashion-poster.jpg">
      <source src="/clones/marcos-arruda-com/videos/home-fashion.mp4" type="video/mp4" />
    </video>
  </section>

  <section class="projects" id="work" aria-labelledby="projects-title">
    <div class="projects__intro">
      <p>SELECTED PROJECTS</p>
      <h2 id="projects-title">Designing alongside people, systems and possibilities.</h2>
    </div>
    <div class="projects__list">
      {homeProjects.map((project) => (
        <article class="project-card">
          <p class="project-card__number">{project.number}</p>
          <h3>{project.title}</h3>
          <p>{project.description}</p>
          <a href={project.href} target={project.href.startsWith("http") ? "_blank" : undefined} rel={project.href.startsWith("http") ? "noreferrer" : undefined}>View project <span aria-hidden="true">↗</span></a>
        </article>
      ))}
    </div>
  </section>

  <section class="collaboration" aria-labelledby="collaboration-title">
    <div class="collaboration__copy">
      <p>PROJECTS &amp; COLLABORATIONS</p>
      <h2 id="collaboration-title">From research and strategy to the details that make an experience matter.</h2>
      <p class="collaboration__body">Recently I have pitched to 5 incredible organisations, including Jacobs Solutions, PVH, Manchester City and Adidas, worked in multi diversity teams, engaged with over 60 leading industry and research voices, written 5 Design Research Activities and pulled together more than 10.000 hours of work on the toughest of real-world problems.</p>
    </div>
    <div class="collaboration__marks" aria-label="Selected collaborators">
      {companyMarks.map((mark) => <img src={mark.src} alt={mark.alt} loading="lazy" />)}
    </div>
  </section>
</main>

<style>
  .home-hero {
    position: relative;
    display: grid;
    min-height: min(100vh, 56rem);
    overflow: hidden;
    color: var(--surface);
    background: var(--bg);
  }

  .home-hero__portrait {
    position: absolute;
    inset: 0 auto 0 0;
    width: 47%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 50%;
    opacity: 0.92;
  }

  .home-hero__content {
    position: relative;
    z-index: 1;
    display: flex;
    width: min(100%, var(--container-max));
    min-height: inherit;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    margin-inline: auto;
    padding: var(--section-y-desktop) var(--container-gutter-desktop);
    padding-left: max(52vw, calc((100vw - var(--container-max)) / 2 + var(--container-gutter-desktop)));
  }

  .home-hero__name,
  .projects__intro > p,
  .home-fashion__copy > p,
  .collaboration__copy > p:first-child,
  .project-card__number {
    margin: 0;
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.09em;
  }

  .home-hero h1 {
    max-width: 42rem;
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 3.55vw, var(--text-3xl));
    font-weight: 300;
    line-height: 1.3;
  }

  .home-hero h1 span {
    color: var(--accent);
  }

  .home-hero__explore,
  .home-fashion__copy a,
  .project-card a {
    display: inline-flex;
    gap: var(--space-2);
    align-items: center;
    margin-top: var(--space-8);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--text-sm);
    font-weight: 500;
    text-decoration: none;
  }

  .home-fashion {
    display: grid;
    grid-template-columns: minmax(16rem, 0.8fr) minmax(0, 1.2fr);
    min-height: 44rem;
    color: var(--surface);
    background: var(--bg);
  }

  .home-fashion__copy {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: var(--section-y-desktop) max(var(--container-gutter-desktop), calc((100vw - var(--container-max)) / 2));
  }

  .home-fashion__copy h2,
  .projects__intro h2,
  .collaboration h2 {
    margin: var(--space-4) 0 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 3.4vw, var(--text-3xl));
    font-weight: 300;
    line-height: 1.24;
  }

  .home-fashion__video {
    width: 100%;
    height: 100%;
    min-height: 28rem;
    object-fit: cover;
  }

  .projects {
    padding: var(--section-y-desktop) var(--container-gutter-desktop);
    color: var(--surface);
    background: var(--bg);
  }

  .projects__intro,
  .projects__list,
  .collaboration {
    width: min(100%, var(--container-max));
    margin-inline: auto;
  }

  .projects__intro {
    max-width: 44rem;
  }

  .projects__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--section-y-tablet);
    border-top: 1px solid color-mix(in srgb, var(--surface), transparent 76%);
  }

  .project-card {
    min-height: 22rem;
    padding: var(--space-8) var(--space-6) var(--space-8) 0;
    border-bottom: 1px solid color-mix(in srgb, var(--surface), transparent 76%);
  }

  .project-card:nth-child(odd) {
    padding-right: var(--section-y-tablet);
  }

  .project-card:nth-child(even) {
    padding-left: var(--section-y-tablet);
    border-left: 1px solid color-mix(in srgb, var(--surface), transparent 76%);
  }

  .project-card h3 {
    margin: var(--space-6) 0 0;
    font-family: var(--font-display);
    font-size: clamp(var(--text-2xl), 4vw, 4.5rem);
    font-weight: 300;
    line-height: var(--leading-tight);
  }

  .project-card > p:not(.project-card__number) {
    max-width: 30rem;
    margin: var(--space-4) 0 0;
    color: var(--muted);
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: var(--leading-body);
  }

  .project-card a {
    margin-top: var(--space-6);
    color: var(--accent-hover);
  }

  .collaboration {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(16rem, 0.9fr);
    gap: var(--section-y-tablet);
    padding: var(--section-y-desktop) var(--container-gutter-desktop);
  }

  .collaboration__body {
    max-width: 42rem;
    margin: var(--space-8) 0 0;
    color: var(--muted);
    font-size: var(--text-lg);
    font-weight: 300;
    line-height: var(--leading-body);
  }

  .collaboration__marks {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-8);
    align-content: center;
  }

  .collaboration__marks img {
    width: 100%;
    max-height: 5rem;
    object-fit: contain;
    filter: grayscale(1) brightness(0) invert(1);
  }

  @media (max-width: 48rem) {
    .home-hero {
      min-height: 43rem;
    }

    .home-hero__portrait {
      inset: auto 0 0;
      width: 100%;
      height: 57%;
      opacity: 0.66;
      object-position: center top;
      -webkit-mask-image: linear-gradient(transparent, var(--bg) 18%);
      mask-image: linear-gradient(transparent, var(--bg) 18%);
    }

    .home-hero__content {
      justify-content: flex-start;
      padding: var(--section-y-phone) var(--container-gutter-phone);
    }

    .home-hero h1 {
      font-size: var(--text-xl);
    }

    .home-fashion,
    .collaboration {
      grid-template-columns: 1fr;
    }

    .home-fashion__copy,
    .projects {
      padding: var(--section-y-phone) var(--container-gutter-phone);
    }

    .home-fashion__video {
      min-height: 20rem;
    }

    .projects__list {
      grid-template-columns: 1fr;
      margin-top: var(--space-12);
    }

    .project-card,
    .project-card:nth-child(odd),
    .project-card:nth-child(even) {
      min-height: auto;
      padding: var(--space-8) 0;
      border-left: 0;
    }

    .collaboration {
      gap: var(--space-12);
      padding: var(--section-y-phone) var(--container-gutter-phone);
    }

    .collaboration__marks {
      gap: var(--space-6);
    }
  }
</style>
