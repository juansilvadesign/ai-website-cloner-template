---
import { contact } from "../data/site";
---

<footer class="site-footer" id="contact">
  <div class="site-footer__inner">
    <div>
      <h2>Want to get in touch?<br />I love meeting new people.</h2>
      <p class="site-footer__name">Marcos Arruda</p>
      <a class="site-footer__contact" href={contact.phoneHref}>{contact.phone}</a>
      <a class="site-footer__contact" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
    <nav class="site-footer__links" aria-label="Footer menu">
      <p>Menu</p>
      <a href="/marcos-arruda-com/">Home</a>
      <a href="/marcos-arruda-com/portfolio/">Projects</a>
      <a href="/marcos-arruda-com/about/">About</a>
    </nav>
    <nav class="site-footer__links" aria-label="Social links">
      <p>Social</p>
      <a href={contact.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={contact.medium} target="_blank" rel="noreferrer">Medium</a>
    </nav>
    <p class="site-footer__credit">Marcos Arruda UX Designer 2024 © All rights reserved. ⭐️ Team is Everything</p>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--surface);
    background: var(--bg);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    gap: var(--section-y-tablet) var(--space-8);
    width: min(100%, var(--container-max));
    margin-inline: auto;
    padding: var(--section-y-desktop) var(--container-gutter-desktop) var(--space-8);
  }

  .site-footer__credit {
    margin: 0;
    color: var(--meta);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.09em;
  }

  .site-footer h2 {
    max-width: 22rem;
    margin: 0;
    color: var(--surface);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-weight: 700;
    line-height: 1.18;
  }

  .site-footer__name {
    margin: var(--space-5) 0 0;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: var(--text-base);
    font-weight: 700;
  }

  .site-footer__contact {
    display: block;
    width: fit-content;
    margin-top: var(--space-2);
    color: var(--surface);
    font-family: var(--font-display);
    font-size: var(--text-base);
    text-decoration: underline;
  }

  .site-footer__links {
    display: grid;
    align-content: start;
    justify-items: start;
    gap: var(--space-3);
  }

  .site-footer__links a {
    color: var(--surface);
    font-family: var(--font-display);
    font-size: var(--text-base);
    text-decoration: none;
    transition: color var(--motion-base) var(--ease-standard);
  }

  .site-footer__links p {
    margin: 0 0 var(--space-1);
    color: var(--meta);
    font-family: var(--font-display);
    font-size: var(--text-xs);
  }

  .site-footer__links a:hover {
    color: var(--accent);
  }

  .site-footer__credit {
    grid-column: 1 / -1;
  }

  @media (max-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding: var(--section-y-phone) var(--container-gutter-phone) var(--space-6);
    }

    .site-footer__links {
      justify-items: start;
    }
  }
</style>
