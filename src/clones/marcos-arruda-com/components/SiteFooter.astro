---
import { contact } from "../data/site";
---

<footer class="site-footer" id="contact">
  <div class="site-footer__inner">
    <div>
      <p class="site-footer__eyebrow">LET'S WORK TOGETHER</p>
      <a class="site-footer__mail" href={`mailto:${contact.email}`}>{contact.email}</a>
    </div>
    <nav class="site-footer__links" aria-label="Footer navigation">
      <a href="/marcos-arruda-com/#work">Work</a>
      <a href="/marcos-arruda-com/about/">About</a>
      <a href={contact.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
      <a href={contact.instagram} target="_blank" rel="noreferrer">Instagram</a>
    </nav>
    <p class="site-footer__credit">© {new Date().getFullYear()} Marcos Arruda</p>
  </div>
</footer>

<style>
  .site-footer {
    color: var(--surface);
    background: var(--bg);
  }

  .site-footer__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: var(--section-y-tablet) var(--space-8);
    width: min(100%, var(--container-max));
    margin-inline: auto;
    padding: var(--section-y-desktop) var(--container-gutter-desktop) var(--space-8);
  }

  .site-footer__eyebrow,
  .site-footer__credit {
    margin: 0;
    color: var(--meta);
    font-family: var(--font-display);
    font-size: var(--text-xs);
    font-weight: 500;
    letter-spacing: 0.09em;
  }

  .site-footer__mail {
    display: inline-block;
    margin-top: var(--space-4);
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(var(--text-xl), 4vw, var(--text-3xl));
    font-weight: 300;
    text-decoration: none;
  }

  .site-footer__links {
    display: grid;
    align-content: start;
    justify-items: end;
    gap: var(--space-3);
  }

  .site-footer__links a {
    color: var(--surface);
    font-family: var(--font-display);
    font-size: var(--text-base);
    text-decoration: none;
    transition: color var(--motion-base) var(--ease-standard);
  }

  .site-footer__links a:hover {
    color: var(--accent);
  }

  .site-footer__credit {
    grid-column: 1 / -1;
  }

  @media (max-width: 48rem) {
    .site-footer__inner {
      grid-template-columns: 1fr;
      gap: var(--space-8);
      padding: var(--section-y-phone) var(--container-gutter-phone) var(--space-6);
    }

    .site-footer__links {
      justify-items: start;
    }
  }
</style>
