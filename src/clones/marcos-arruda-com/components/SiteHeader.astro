---
interface Props {
  tone?: "light" | "dark";
  overlay?: boolean;
}

const { tone = "dark", overlay = false } = Astro.props;
---

<header class:list={["site-header", `site-header--${tone}`, { "site-header--overlay": overlay }]}>
  <a class="site-header__identity" href="/marcos-arruda-com/" aria-label="Marcos Arruda home">
    <span>Marcos Arruda</span>
    <small>UX &amp; Service <em>Designer</em></small>
  </a>
  <button class="site-header__menu" type="button" aria-label="Open menu" aria-expanded="false" aria-controls="marcos-site-menu" data-menu-toggle>
    <span></span><span></span><span></span>
  </button>
</header>

<dialog class="site-menu" id="marcos-site-menu" aria-label="Site navigation" data-site-menu>
  <div class="site-menu__image" aria-hidden="true"></div>
  <button class="site-menu__close" type="button" aria-label="Close menu" data-menu-close>×</button>
  <nav class="site-menu__nav" aria-label="Primary navigation">
    <a href="/marcos-arruda-com/#work" data-menu-link>Work</a>
    <a href="/marcos-arruda-com/about/" data-menu-link>About</a>
    <a href="/marcos-arruda-com/#contact" data-menu-link>Contact</a>
  </nav>
</dialog>

<script>
  const dialog = document.querySelector("[data-site-menu]");
  const toggle = document.querySelector("[data-menu-toggle]");
  const close = document.querySelector("[data-menu-close]");

  if (dialog instanceof HTMLDialogElement && toggle instanceof HTMLButtonElement) {
    const closeMenu = () => {
      dialog.close();
      toggle.setAttribute("aria-expanded", "false");
    };
    toggle.addEventListener("click", () => {
      dialog.showModal();
      toggle.setAttribute("aria-expanded", "true");
    });
    close?.addEventListener("click", closeMenu);
    dialog.querySelectorAll("[data-menu-link]").forEach((link) => link.addEventListener("click", closeMenu));
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) closeMenu();
    });
  }
</script>

<style>
  .site-header {
    position: relative;
    z-index: 5;
    display: flex;
    min-height: 6.9375rem;
    align-items: center;
    justify-content: space-between;
    padding-inline: var(--container-gutter-desktop);
    font-family: var(--font-display);
  }

  .site-header--dark {
    color: var(--fg);
    background: var(--surface);
  }

  .site-header--light {
    color: var(--surface);
    background: var(--bg);
  }

  .site-header--overlay {
    position: absolute;
    inset: 0 0 auto;
    background: transparent;
  }

  .site-header__identity {
    display: grid;
    gap: var(--space-1);
    color: inherit;
    line-height: var(--leading-tight);
    text-decoration: none;
  }

  .site-header__identity span {
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .site-header__identity small {
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .site-header__identity em {
    padding-inline: var(--space-1);
    color: var(--accent-on);
    font-style: normal;
    background: var(--accent);
  }

  .site-header__menu {
    display: grid;
    width: 2.25rem;
    gap: 0.32rem;
    padding: 0;
    color: inherit;
    background: transparent;
    border: 0;
    cursor: pointer;
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .site-header__menu:hover {
    transform: translateY(-0.18rem);
  }

  .site-header__menu span {
    display: block;
    height: 0.12rem;
    background: currentColor;
  }

  .site-header__menu span:last-child {
    width: 72%;
    justify-self: end;
  }

  .site-menu {
    position: fixed;
    z-index: 100;
    width: 100vw;
    max-width: none;
    height: 100dvh;
    max-height: none;
    padding: 0;
    overflow: hidden;
    color: var(--surface);
    background: var(--bg);
    border: 0;
  }

  .site-menu::backdrop {
    background: var(--bg);
  }

  .site-menu__image {
    position: absolute;
    inset: 0 auto 0 0;
    width: 45%;
    opacity: 0.62;
    background: linear-gradient(90deg, transparent, var(--bg)), url("/clones/marcos-arruda-com/images/home-portrait.jpg") center / cover;
  }

  .site-menu__close {
    position: absolute;
    top: var(--space-6);
    right: var(--container-gutter-desktop);
    z-index: 1;
    padding: 0;
    color: var(--accent);
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 5vw, 5.5rem);
    font-weight: 300;
    line-height: 0.8;
    background: transparent;
    border: 0;
    cursor: pointer;
  }

  .site-menu__nav {
    position: relative;
    z-index: 1;
    display: grid;
    height: 100%;
    align-content: center;
    justify-items: center;
    gap: var(--space-5);
  }

  .site-menu__nav a {
    color: var(--surface);
    font-family: var(--font-display);
    font-size: clamp(var(--text-3xl), 8vw, 7rem);
    font-weight: 300;
    line-height: var(--leading-tight);
    text-decoration: none;
    transition: color var(--motion-base) var(--ease-standard);
  }

  .site-menu__nav a:hover {
    color: var(--accent);
  }

  @media (max-width: 48rem) {
    .site-header {
      min-height: 5.125rem;
      padding-inline: var(--space-5);
    }

    .site-header__identity span {
      font-size: var(--text-base);
    }

    .site-menu__image {
      width: 100%;
      opacity: 0.28;
      background: linear-gradient(90deg, var(--bg), transparent), url("/clones/marcos-arruda-com/images/home-portrait.jpg") center / cover;
    }

    .site-menu__close {
      right: var(--container-gutter-phone);
    }
  }
</style>
