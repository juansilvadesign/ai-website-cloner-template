---
type FooterGroup = [string, Array<[string, string]>];

const groups: FooterGroup[] = [
  ["Navigation", [["Features", "/reworkd-ai/#features"], ["Customers", "/reworkd-ai/#customers"], ["Pricing", "https://www.reworkd.ai/pricing"], ["Talk to us", "https://reworkd.typeform.com/to/qscfsOf1"], ["We're hiring", "https://www.ycombinator.com/companies/reworkd/jobs"]]],
  ["Other", [["Docs", "https://www.reworkd.ai/docs"], ["Blog", "https://www.reworkd.ai/blog"], ["Privacy policy", "https://www.reworkd.ai/privacy"], ["Terms & Conditions", "https://www.reworkd.ai/terms"]]],
  ["Social", [["LinkedIn", "https://www.linkedin.com/company/reworkd/"], ["GitHub", "https://github.com/reworkd"], ["X (formerly Twitter)", "https://x.com/reworkdai"]]],
];
---

<footer class="rw-footer">
  <div class="rw-footer-main">
    <div class="rw-footer-brand"><a href="/reworkd-ai/" aria-label="Reworkd home"><svg aria-hidden="true" viewBox="0 0 36 24" width="36" height="24"><path d="M3 6.5h9.1l5.9 5.5L12.1 17.5H3z" fill="currentColor"/><path d="M18 6.5h6.4L33 12l-8.6 5.5H18l6.7-5.5z" fill="currentColor" opacity=".48"/></svg><span>Reworkd</span></a><p>550 15th St<br />San Francisco, CA 94103</p></div>
    <div class="rw-footer-groups">
      {groups.map(([heading, links]) => <section><h2>{heading}</h2><ul>{links.map(([label, href]) => <li><a href={href}>{label}</a></li>)}</ul></section>)}
    </div>
  </div>
  <div class="rw-footer-legal"><span>© Reworkd AI, Inc.</span><a href="https://status.reworkd.ai/"><i aria-hidden="true"></i>All services are operational</a></div>
</footer>

<style>
  .rw-footer { width: min(100% - (var(--container-gutter-phone) * 2), 1216px); margin: 0 auto; padding: 42px 0 var(--space-6); color: var(--muted); }
  .rw-footer-main { display: grid; gap: 48px; } .rw-footer-brand a { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--fg); font-size: var(--text-sm); font-weight: 500; letter-spacing: -0.02em; } .rw-footer-brand svg { width: 29px; height: 20px; } .rw-footer-brand p { margin: var(--space-4) 0 0; font-size: var(--text-xs); line-height: var(--leading-body); }
  .rw-footer-groups { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 32px var(--space-6); } .rw-footer-groups section:last-child { grid-column: span 2; } .rw-footer-groups h2 { margin: 0; color: var(--fg); font-size: var(--text-sm); font-weight: 500; } .rw-footer-groups ul { display: grid; gap: var(--space-2); margin: var(--space-4) 0 0; padding: 0; list-style: none; } .rw-footer-groups a { font-size: var(--text-xs); transition: color var(--motion-fast) var(--ease-standard); } .rw-footer-groups a:hover { color: var(--fg); }
  .rw-footer-legal { display: flex; flex-wrap: wrap; justify-content: space-between; gap: var(--space-3); margin-top: 40px; padding-top: var(--space-5); border-top: 1px solid var(--border-soft); color: var(--meta); font-size: var(--text-xs); } .rw-footer-legal a { display: inline-flex; align-items: center; gap: var(--space-2); } .rw-footer-legal i { width: 5px; height: 5px; border-radius: var(--radius-pill); background: var(--accent); }
  @media (min-width: 768px) { .rw-footer { padding-top: 56px; } .rw-footer-main { grid-template-columns: 1fr 519px; } .rw-footer-groups { grid-template-columns: 79px 132px 149px; gap: 40px; } .rw-footer-groups section:last-child { grid-column: auto; } }
  @media (min-width: 1024px) { .rw-footer { padding-top: 56px; padding-bottom: 72px; } }
</style>
