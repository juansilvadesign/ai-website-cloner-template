---
import "../styles/clone.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Adspirer — Hire an AI Paid Media Manager",
  description = "AI agents that run your paid media. Build campaigns, monitor spend, and work with the tools your team already uses.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f6f8fa" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <link rel="canonical" href="https://www.adspirer.com/" />
    <link rel="icon" type="image/svg+xml" href="/clones/adspirer-com/seo/favicon.svg" />
    <link rel="icon" type="image/png" href="/clones/adspirer-com/seo/favicon.png" />
    <link rel="apple-touch-icon" href="/clones/adspirer-com/seo/apple-icon.png" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="/clones/adspirer-com/seo/opengraph.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <slot />
  </body>
</html>
