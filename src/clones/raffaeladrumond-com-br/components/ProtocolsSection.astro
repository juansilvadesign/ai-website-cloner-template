---
const protocols = [
  ["Liftera Full Face", "O LIFTERA 2 é realizado em toda a Face e Pescoço para tratar a flacidez e estimular a produção de colágeno."],
  ["Red Touch", "Utilizamos o Laser RED TOUCH e ativos da Medicina Regenerativa para tratar Face toda e Pescoço. A intenção é estimular colágeno nas camadas superficiais e uniformizar a tonalidade da pele, sem aquele pós desagradável."],
  ["Melasma Control", "Associação de 3 Tecnologias com Ativos da Medicina Regenerativa e Skincare personalizado. Tratando Face toda e Pescoço. O objetivo é clarear e controlar o Melasma."],
  ["Regenera", "Associação de 4 Tecnologias com ativos da Medicina Regenerativa para tratar Face toda e Pescoço. O objetivo é tratar a qualidade de pele como rugas, manchas de sol, poros abertos, pele grossa e opaca."],
  ["Glass Beauty", "Associação de 2 Tecnologias com o famoso Peeling Coreano LHA LA PEEL. Trata face e pescoço. O objetivo é melhorar a qualidade de pele devolvendo aquela “Pele de Porcelana”."],
  ["Glow", "Associação do Laser ZYE com ativos da Medicina Regenerativa. Trata somente Face. O objetivo é tratar a qualidade de pele porém de maneira menos agressiva e com um pós mais tranquilo."],
  ["Coolpeel", "Associação do Laser Punto com ativos da Medicina Regenerativa. Trata somente Face. O objetivo é melhorar a qualidade de Pele."],
  ["Tec Pro", "Associação de todas as Tecnologias da Clínica em uma única sessão anual. Tratando todas as camadas da Pele, desde a mais profunda até a mais superficial. Para aqueles Pacientes que não gostam dos Injetáveis."],
  ["Lift Eyes", "Neste Protocolo, tratamos o envelhecimento da área dos olhos, como pálpebras craqueladas, rugas, olhar cansado e queda das sobrancelhas. O tratamento é realizado com 3 tecnologias: LIFTERA, OLÍGIO X e PUNTO."],
];
---

<section id="protocolos" class="protocols rd-section" aria-labelledby="protocols-title">
  <div class="rd-container">
    <header class="protocols-intro" data-reveal>
      <img src="/clones/raffaeladrumond-com-br/images/PROTOCOLO.png" alt="" width="242" height="29" loading="lazy" />
      <p class="rd-eyebrow">Protocolos da Clínica</p>
      <h2 id="protocols-title" class="rd-title">Conheça os protocolos da Clínica RD</h2>
      <p class="rd-copy">A clínica também oferece protocolos de tratamento desenvolvidos pela Dra. Raffaela, que combinam as tecnologias mais modernas com injetáveis de última geração.</p>
    </header>
    <div class="protocol-grid">
      {protocols.map(([name, description], index) => (
        <article class="protocol-card" data-reveal>
          <span>{String(index + 1).padStart(2, "0")}</span>
          <h3>{name}</h3>
          <p>{description}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .protocols {
    background: var(--fg);
    color: var(--surface);
  }

  .protocols-intro {
    max-width: 810px;
    margin-bottom: var(--space-12);
  }

  .protocols-intro img {
    display: block;
    width: 158px;
    height: auto;
    margin-bottom: var(--space-6);
    filter: brightness(0) invert(1);
  }

  .protocols-intro .rd-eyebrow,
  .protocols-intro .rd-title,
  .protocols-intro .rd-copy {
    color: var(--surface);
  }

  .protocols-intro .rd-copy {
    max-width: 680px;
    margin-top: var(--space-6);
  }

  .protocol-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--surface), transparent 75%);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--surface), transparent 75%);
  }

  .protocol-card {
    min-height: 260px;
    padding: var(--space-6);
    background: var(--fg);
  }

  .protocol-card span {
    color: color-mix(in srgb, var(--surface), transparent 48%);
    font-size: var(--text-xs);
    letter-spacing: .12em;
  }

  .protocol-card h3 {
    margin: var(--space-6) 0 var(--space-4);
    color: var(--surface);
    font-family: var(--font-display);
    font-size: var(--text-2xl);
    font-weight: 300;
  }

  .protocol-card p {
    margin: 0;
    color: color-mix(in srgb, var(--surface), transparent 19%);
    font-size: var(--text-sm);
    line-height: 1.67;
  }

  @media (max-width: 899px) {
    .protocol-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 549px) {
    .protocol-grid {
      grid-template-columns: 1fr;
    }

    .protocol-card {
      min-height: auto;
    }
  }
</style>
