---
const whatsappUrl =
  "https://wa.me/5561999195497?text=Ol%C3%A1%2C%20estive%20no%20site%20e%20gostaria%20de%20agendar%20uma%20consulta.";

const navigation = [
  ["#tratamentos", "Tratamentos"],
  ["#tecnologias", "Tecnologias"],
  ["#sobre", "Sobre a Dra."],
  ["#depoimentos", "Depoimentos"],
  ["#protocolos", "Protocolos da Clínica"],
  ["#clinica", "Conheça a Clínica"],
  ["#contatos", "Contatos"],
];
---

<header class="site-header">
  <div class="rd-container header-inner">
    <button class="menu-toggle" type="button" aria-label="Abrir menu" aria-controls="site-menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>

    <a class="brand" href="#top" aria-label="Clínica Raffaela Drumond">
      <img src="/clones/raffaeladrumond-com-br/images/Group-1707478973.png" alt="Dra. Raffaela Drumond" width="376" height="145" />
    </a>

    <nav class="header-actions" aria-label="Contato rápido">
      <a href="tel:+5561999195497" class="quick-contact">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6.7 2.9 9.4 2c.7-.2 1.4.1 1.7.8l1.2 3c.3.7.1 1.4-.5 1.9l-1.5 1.2c1.1 2.3 2.9 4.1 5.2 5.2l1.2-1.5c.5-.6 1.2-.8 1.9-.5l3 1.2c.7.3 1 .9.8 1.7l-.9 2.7c-.2.6-.8 1-1.4 1C10.2 17.7 6.3 13.8 6.3 4.9c0-.6.4-1.2.4-2Z" /></svg>
        <span>(61) 9 99195-497</span>
      </a>
      <a href={whatsappUrl} class="quick-contact" target="_blank" rel="noreferrer">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 11.7a8.4 8.4 0 0 1-12.5 7.3L3.5 20.4l1.4-4.3A8.4 8.4 0 1 1 20.4 11.7ZM12 5a6.7 6.7 0 0 0-5.8 10l.3.5-.8 2.3 2.4-.8.5.3A6.7 6.7 0 1 0 12 5Zm3.9 8.6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.8c-.1.2-.3.2-.5.1-1.4-.7-2.4-1.8-3-3.1-.1-.2 0-.4.1-.5l.4-.5.2-.4-.1-.4-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.7 1.1 2.9c.1.2 2 3.1 4.8 4.3.7.3 1.3.5 1.8.6.8.2 1.4.2 2 .1.6-.1 1.8-.7 2.1-1.4.3-.6.3-1.2.2-1.4-.1-.1-.3-.2-.5-.3Z" /></svg>
        <span>(61) 9 99195-497</span>
      </a>
    </nav>
  </div>
</header>

<aside id="site-menu" class="menu-overlay" aria-label="Navegação principal" aria-hidden="true">
  <div class="overlay-top">
    <a class="overlay-brand" href="#top">
      <img src="/clones/raffaeladrumond-com-br/images/Group-1707478973.png" alt="Dra. Raffaela Drumond" width="376" height="145" />
    </a>
    <button class="menu-close" type="button" aria-label="Fechar menu">×</button>
  </div>
  <nav class="overlay-nav">
    {navigation.map(([href, label], index) => (
      <a href={href}><span>0{index + 1}</span>{label}</a>
    ))}
  </nav>
  <a class="overlay-whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer">Agendar pelo WhatsApp <span aria-hidden="true">↗</span></a>
</aside>

<script>
  const toggle = document.querySelector<HTMLButtonElement>(".menu-toggle");
  const overlay = document.querySelector<HTMLElement>(".menu-overlay");
  const close = document.querySelector<HTMLButtonElement>(".menu-close");

  const setMenu = (open: boolean) => {
    if (!toggle || !overlay) return;
    toggle.setAttribute("aria-expanded", String(open));
    toggle.setAttribute("aria-label", open ? "Fechar menu" : "Abrir menu");
    overlay.setAttribute("aria-hidden", String(!open));
    overlay.classList.toggle("is-open", open);
    document.documentElement.classList.toggle("menu-is-open", open);
  };

  toggle?.addEventListener("click", () => setMenu(toggle.getAttribute("aria-expanded") !== "true"));
  close?.addEventListener("click", () => setMenu(false));
  overlay?.querySelectorAll("a").forEach((link) => link.addEventListener("click", () => setMenu(false)));
  window.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setMenu(false);
  });
</script>

<style>
  .site-header {
    position: absolute;
    z-index: 20;
    top: 0;
    width: 100%;
    padding-block: 30px var(--space-5);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto auto minmax(0, 1fr);
    align-items: center;
    gap: 42px;
  }

  .menu-toggle {
    display: inline-flex;
    width: 40px;
    min-height: 61px;
    align-items: center;
    justify-content: center;
    justify-self: start;
    flex-direction: column;
    gap: 7px;
    border: 0;
    background: transparent;
    color: var(--fg-2);
    cursor: pointer;
  }

  .menu-toggle span {
    display: block;
    width: 32px;
    height: 2px;
    background: currentColor;
  }

  .brand img,
  .overlay-brand img {
    display: block;
    width: 188px;
    height: auto;
  }

  .header-actions {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 36px;
    color: var(--fg);
    font-size: var(--text-sm);
  }

  .quick-contact {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: var(--fg-2);
    font-size: 20px;
    font-weight: 400;
    white-space: nowrap;
  }

  .quick-contact svg {
    width: 21px;
    height: 21px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.3;
  }

  .quick-contact:last-child svg {
    fill: currentColor;
    stroke: none;
  }

  @media (min-width: 720px) {
    .menu-toggle {
      transform: translateX(18px);
    }

    .brand {
      transform: translateX(4px);
    }

    .quick-contact:first-child { order: 2; }
    .quick-contact:last-child { order: 1; }
  }

  .overlay-whatsapp {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--accent-on);
    background: var(--accent);
    border-radius: var(--radius-pill);
    padding: var(--space-3) var(--space-5);
    transition: background-color var(--motion-fast) var(--ease-standard);
  }

  .quick-contact:hover,
  .overlay-whatsapp:hover {
    color: var(--accent-hover);
  }

  .menu-overlay {
    position: fixed;
    z-index: 100;
    inset: 0;
    display: flex;
    flex-direction: column;
    padding: var(--space-8) max(var(--container-gutter-desktop), calc((100vw - min(1200px, var(--container-max))) / 2));
    background: #4b4f52;
    color: var(--surface);
    opacity: 0;
    pointer-events: none;
    transition: opacity 400ms var(--ease-standard);
  }

  .menu-overlay.is-open {
    opacity: 1;
    pointer-events: auto;
  }

  .overlay-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .overlay-brand {
    filter: brightness(0) invert(1);
  }

  .menu-close {
    border: 0;
    background: transparent;
    color: var(--surface);
    font-family: var(--font-display);
    font-size: 52px;
    font-weight: 300;
    line-height: 1;
    cursor: pointer;
  }

  .overlay-nav {
    display: grid;
    gap: var(--space-3);
    margin: auto 0;
  }

  .overlay-nav a {
    display: flex;
    align-items: baseline;
    gap: var(--space-5);
    width: fit-content;
    color: var(--surface);
    font-family: var(--font-display);
    font-size: clamp(30px, 4vw, 52px);
    font-weight: 300;
    line-height: 1.1;
  }

  .overlay-nav span {
    color: color-mix(in srgb, var(--surface), transparent 45%);
    font-family: var(--font-body);
    font-size: var(--text-xs);
    letter-spacing: .08em;
  }

  .overlay-whatsapp {
    align-self: flex-start;
  }

  @media (max-width: 719px) {
    .site-header {
      padding-block: 30px 0;
    }

    .site-header .rd-container {
      width: calc(100% - 20px);
    }

    .header-inner {
      grid-template-columns: auto 1fr auto;
      gap: 0;
    }

    .menu-toggle {
      width: 56px;
    }

    .brand img,
    .overlay-brand img {
      width: 88px;
    }

    .brand {
      justify-self: end;
      transform: translateX(-21px);
    }

    .header-actions {
      display: none;
    }

    .menu-overlay {
      padding: var(--space-5) var(--container-gutter-phone);
    }
  }
</style>
