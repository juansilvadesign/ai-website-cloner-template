---
const testimonials = [
  ["“O atendimento é atencioso desde a primeira conversa. Tudo é explicado com calma, e isso traz muita segurança.”", "Paciente da Clínica RD"],
  ["“O resultado ficou muito natural. A Dra. Raffaela entende exatamente o que faz sentido para cada rosto.”", "Paciente da Clínica RD"],
  ["“A clínica é linda, acolhedora e muito organizada. Me senti cuidada em todas as etapas.”", "Paciente da Clínica RD"],
];
---

<section id="depoimentos" class="testimonials rd-section" aria-labelledby="testimonials-title">
  <div class="rd-container">
    <header class="testimonials-intro" data-reveal>
      <p class="rd-eyebrow">Depoimentos de pacientes</p>
      <h2 id="testimonials-title" class="rd-title">O que pacientes dizem após o atendimento.</h2>
      <p class="rd-copy">Os depoimentos de nossos pacientes refletem não apenas os resultados dos tratamentos, mas também a atenção, respeito e dedicação da Dra. Raffaela Drumond em cada etapa do cuidado com a saúde dos pacientes.</p>
    </header>
    <div class="testimonial-grid">
      {testimonials.map(([quote, attribution]) => (
        <blockquote data-reveal>
          <div class="stars" aria-label="5 de 5 estrelas">★★★★★</div>
          <p>{quote}</p>
          <footer>{attribution}</footer>
        </blockquote>
      ))}
    </div>
  </div>
</section>

<style>
  .testimonials {
    background: var(--surface-warm);
  }

  .testimonials-intro {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: var(--space-8);
    align-items: end;
    margin-bottom: var(--space-12);
  }

  .testimonials-intro .rd-copy {
    max-width: 540px;
    margin-left: auto;
  }

  .testimonial-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-5);
  }

  blockquote {
    display: flex;
    min-height: 270px;
    flex-direction: column;
    margin: 0;
    padding: var(--space-6);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    background: var(--surface);
  }

  .stars {
    color: var(--accent);
    font-size: var(--text-sm);
    letter-spacing: .12em;
  }

  blockquote p {
    margin: var(--space-6) 0 auto;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: var(--text-xl);
    font-style: italic;
    font-weight: 300;
    line-height: 1.35;
  }

  blockquote footer {
    margin-top: var(--space-6);
    color: var(--muted);
    font-size: var(--text-xs);
  }

  @media (max-width: 719px) {
    .testimonials-intro {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .testimonials-intro .rd-copy {
      margin-left: 0;
    }

    .testimonial-grid {
      grid-template-columns: 1fr;
    }

    blockquote {
      min-height: 225px;
    }
  }
</style>
