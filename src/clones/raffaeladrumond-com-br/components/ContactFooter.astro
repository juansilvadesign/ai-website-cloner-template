---
const whatsappUrl =
  "https://wa.me/5561999195497?text=Ol%C3%A1%2C%20estive%20no%20site%20e%20gostaria%20de%20agendar%20uma%20consulta.";
const mapUrl =
  "https://maps.google.com/maps?q=SGAS%20915%2C%20Salas%20210%2F212%2C%202%C2%BA%20Andar%20-%20Advance%202%20-%20Asa%20Sul%2C%20Bras%C3%ADlia%20-%20DF%2C%2070390-150&t=m&z=18&output=embed&iwloc=near";
---

<section id="contatos" class="contact" aria-labelledby="contact-title">
  <div class="contact-top" data-reveal>
    <div class="contact-top-inner">
      <img src="/clones/raffaeladrumond-com-br/images/Group-1707479097.png" alt="Dra. Raffaela Drumond, Médica Dermatologista" width="712" height="173" loading="lazy" />
      <a class="channels-pill" href={whatsappUrl} target="_blank" rel="noreferrer"><span aria-hidden="true">✦</span> NOSSOS CANAIS DE ATENDIMENTO</a>
    </div>
  </div>

  <div class="contact-main">
    <article class="contact-address" data-reveal>
      <h2 id="contact-title">Clínica Raffaela Drumond</h2>
      <p>SGAS 915, Salas 210/212, 2º Andar – Advance 2 – Asa Sul, Brasília – DF, 70390-150</p>
      <iframe
        loading="lazy"
        src={mapUrl}
        title="SGAS 915, Salas 210/212, 2º Andar - Advance 2 - Asa Sul, Brasília - DF, 70390-150"
      ></iframe>
    </article>

    <article class="contact-hours" data-reveal>
      <h2>Endereço e atendimento</h2>
      <h3>Horário de atendimento</h3>
      <p>Segunda a sexta 08h30 às 18h</p>
      <h3>Agendamento de consultas</h3>
      <a href={whatsappUrl} target="_blank" rel="noreferrer">WhatsApp: (61) 9 99195-497</a>
      <div class="social-links" aria-label="Redes sociais">
        <a href="https://www.instagram.com/dra.raffaeladrumond/" target="_blank" rel="noreferrer" aria-label="Instagram">
          <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.4" cy="6.7" r="1" fill="currentColor" stroke="none" /></svg>
        </a>
        <a href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="WhatsApp">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 11.7a8.4 8.4 0 0 1-12.5 7.3L3.5 20.4l1.4-4.3A8.4 8.4 0 1 1 20.4 11.7ZM12 5a6.7 6.7 0 0 0-5.8 10l.3.5-.8 2.3 2.4-.8.5.3A6.7 6.7 0 1 0 12 5Zm3.9 8.6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.8c-.1.2-.3.2-.5.1-1.4-.7-2.4-1.8-3-3.1-.1-.2 0-.4.1-.5l.4-.5.2-.4-.1-.4-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.7 1.1 2.9c.1.2 2 3.1 4.8 4.3.7.3 1.3.5 1.8.6.8.2 1.4.2 2 .1.6-.1 1.8-.7 2.1-1.4.3-.6.3-1.2.2-1.4-.1-.1-.3-.2-.5-.3Z" /></svg>
        </a>
      </div>
    </article>
  </div>

  <footer class="contact-legal">
    <p>Dra. Raffaela Bruno Drumond CRM 14.344 – DF | RQE 7085</p>
    <p>© 2026 Clínica Raffaela Drumond | Todos os direitos reservados.</p>
  </footer>
</section>

<a class="floating-whatsapp" href={whatsappUrl} target="_blank" rel="noreferrer" aria-label="Agendar pelo WhatsApp">
  <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20.4 11.7a8.4 8.4 0 0 1-12.5 7.3L3.5 20.4l1.4-4.3A8.4 8.4 0 1 1 20.4 11.7ZM12 5a6.7 6.7 0 0 0-5.8 10l.3.5-.8 2.3 2.4-.8.5.3A6.7 6.7 0 1 0 12 5Zm3.9 8.6c-.2-.1-1.4-.7-1.6-.8-.2-.1-.4-.1-.5.1l-.7.8c-.1.2-.3.2-.5.1-1.4-.7-2.4-1.8-3-3.1-.1-.2 0-.4.1-.5l.4-.5.2-.4-.1-.4-.8-1.8c-.2-.5-.4-.4-.5-.4h-.5c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.4s1 2.7 1.1 2.9c.1.2 2 3.1 4.8 4.3.7.3 1.3.5 1.8.6.8.2 1.4.2 2 .1.6-.1 1.8-.7 2.1-1.4.3-.6.3-1.2.2-1.4-.1-.1-.3-.2-.5-.3Z" /></svg>
</a>

<style>
  .contact {
    position: relative;
    box-sizing: border-box;
    height: 821px;
    overflow: hidden;
    background: #484e33 url("/clones/raffaeladrumond-com-br/images/Frame-1707480874.png") center top / cover no-repeat;
    color: var(--surface);
  }

  .contact-top {
    box-sizing: border-box;
    height: 166px;
    border-bottom: 1px solid rgba(255, 255, 255, .85);
  }

  .contact-top-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(1200px, calc(100% - 64px));
    height: 100%;
    margin-inline: auto;
    padding: 24px 0;
  }

  .contact-top img {
    display: block;
    width: 399px;
    height: 97px;
    object-fit: contain;
  }

  .channels-pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    box-sizing: border-box;
    width: 331px;
    min-height: 56px;
    border: 1px solid rgba(255, 255, 255, .7);
    border-radius: 100px;
    color: var(--surface);
    font-size: 11px;
    font-weight: 500;
    line-height: 1;
  }

  .channels-pill span { font-size: 23px; line-height: 0; }

  .contact-main {
    display: grid;
    grid-template-columns: 507px 483px;
    gap: 150px;
    width: 1140px;
    margin: 0 auto;
    padding-top: 78px;
  }

  .contact-address h2,
  .contact-hours h2 {
    margin: 0;
    color: #f2f2f2;
    font-family: var(--font-display);
    font-size: 48px;
    font-weight: 300;
    line-height: 1.25;
  }

  .contact-address p {
    width: 446px;
    margin: 28px 0 19px;
    color: var(--surface);
    font-size: 20px;
    line-height: 1.5;
  }

  .contact-address iframe {
    display: block;
    width: 507px;
    height: 300px;
    border: 0;
    border-radius: 0;
  }

  .contact-hours h3 {
    margin: 33px 0 0;
    color: #f2f2f2;
    font-family: var(--font-display);
    font-size: 32px;
    font-weight: 300;
    line-height: 1.25;
  }

  .contact-hours h3 + p {
    margin: 20px 0 0;
  }

  .contact-hours p,
  .contact-hours > a {
    display: block;
    margin: 0;
    color: var(--surface);
    font-size: 20px;
    line-height: 1.5;
  }

  .contact-hours > a { margin-top: 20px; }

  .social-links {
    display: flex;
    gap: 14px;
    margin-top: 20px;
  }

  .social-links a {
    display: grid;
    width: 50px;
    height: 50px;
    place-items: center;
    border-radius: 50%;
    background: var(--surface);
    color: var(--fg-2);
  }

  .social-links svg {
    width: 23px;
    height: 23px;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.5;
  }

  .social-links a:last-child svg { fill: currentColor; stroke: none; }

  .contact-legal {
    position: absolute;
    right: max(104px, calc((100% - 1232px) / 2));
    bottom: -5px;
    left: max(104px, calc((100% - 1232px) / 2));
    display: flex;
    justify-content: space-between;
    gap: 32px;
    color: var(--fg-2);
    font-size: 18px;
    line-height: 1;
  }

  .contact-legal p { margin: 0; }

  .floating-whatsapp {
    position: fixed;
    z-index: 30;
    right: 18px;
    bottom: 17px;
    display: grid;
    width: 64px;
    height: 64px;
    place-items: center;
    border-radius: 50%;
    background: #25d366;
    color: var(--surface);
    box-shadow: var(--elev-raised);
    transition: transform var(--motion-fast) var(--ease-standard);
  }

  .floating-whatsapp:hover { transform: translateY(-1px); }

  .floating-whatsapp svg {
    width: 35px;
    height: 35px;
    fill: currentColor;
  }

  @media (max-width: 1199px) {
    .contact-main {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: clamp(48px, 9vw, 120px);
      width: min(calc(100% - 64px), 1000px);
    }

    .contact-address iframe { width: 100%; }
  }

  @media (max-width: 719px) {
    .contact {
      height: auto;
      min-height: 0;
      padding-bottom: 70px;
      overflow: visible;
      background-position: 58% top;
    }

    .contact-top {
      height: auto;
    }

    .contact-top-inner {
      flex-direction: column;
      align-items: flex-start;
      width: calc(100% - 40px);
      gap: 26px;
      padding: 24px 0;
    }

    .contact-top img {
      width: min(280px, 100%);
      height: auto;
    }

    .channels-pill {
      width: 100%;
      min-height: 50px;
      font-size: 9px;
    }

    .contact-main {
      grid-template-columns: 1fr;
      gap: 46px;
      width: calc(100% - 40px);
      padding-top: 48px;
    }

    .contact-address h2,
    .contact-hours h2 { font-size: 38px; line-height: 1.12; }

    .contact-address p {
      width: auto;
      margin-top: 22px;
      font-size: 17px;
    }

    .contact-address iframe { height: 250px; }

    .contact-hours h3 {
      margin-top: 28px;
      font-size: 27px;
    }

    .contact-hours p,
    .contact-hours > a { font-size: 17px; }

    .contact-legal {
      position: static;
      flex-direction: column;
      gap: 10px;
      width: calc(100% - 40px);
      margin: 44px auto 0;
      color: rgba(255, 255, 255, .72);
      font-size: 12px;
      line-height: 1.35;
    }

    .floating-whatsapp {
      right: 16px;
      bottom: 16px;
      width: 58px;
      height: 58px;
    }

    .floating-whatsapp svg {
      width: 32px;
      height: 32px;
    }
  }
</style>
