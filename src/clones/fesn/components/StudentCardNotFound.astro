---
/** Not-found state of `/student-card`. Spec: docs/research/fesn/components/student-card-notfound.spec.md */
import Icon from "./Icon.astro";
---

<main class="shell">
  <div class="card">
    <div class="head">
      <span class="badge">Resultado</span>
      <div class="circle">
        <Icon name="search-x" size={20} />
      </div>
      <h1>Carteirinha não encontrada</h1>
      <p class="body">
        A carteirinha pode não existir ou podemos estar enfrentando um problema técnico no momento.
      </p>
    </div>

    <div class="foot">
      <a class="btn btn--primary wide" href="/fesn/">Tentar novamente</a>
      <a class="btn btn--secondary wide" href="/fesn/">Voltar para inicio</a>
      <p class="note">Se o problema persistir, entre em contato com o suporte da FESN.</p>
    </div>
  </div>
</main>

<style>
  .shell {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 100vh;
    padding: var(--space-8) var(--container-gutter-phone);
    background-image: linear-gradient(
      var(--shell-grad-top) 0%,
      var(--shell-grad-mid) 50%,
      rgb(241 245 249 / 0.4) 100%
    );
  }

  .card {
    width: 100%;
    max-width: 512px;
    display: flex;
    flex-direction: column;
    gap: var(--space-6);
    padding-block: var(--space-6);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
  }

  .head {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-8) var(--space-6) 0;
    text-align: center;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    height: 26.5px;
    padding: var(--space-1) var(--space-3);
    margin: 0 auto var(--space-4);
    border: 1px solid transparent;
    border-radius: var(--radius-pill);
    background: var(--action-soft);
    color: var(--fg-2);
    font-size: 11px;
    font-weight: 500;
    line-height: 16.5px;
    letter-spacing: 1.54px;
    text-transform: uppercase;
  }

  .circle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 48px;
    height: 48px;
    margin: 0 auto var(--space-4);
    border-radius: var(--radius-pill);
    background: #f1f5f9;
    color: var(--fg-2);
  }

  h1 {
    margin-bottom: var(--space-4);
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 32px;
    letter-spacing: -0.75px;
    color: var(--fg);
  }

  .body {
    max-width: 448px;
    margin-inline: auto;
    font-size: var(--text-sm);
    line-height: 22.75px;
    color: var(--muted);
  }

  .foot {
    padding: 0 var(--space-6) var(--space-8);
  }

  .wide {
    width: 100%;
  }

  .wide + .wide {
    margin-top: var(--space-3);
  }

  .note {
    margin-top: var(--space-3);
    font-size: var(--text-xs);
    line-height: 19.5px;
    color: var(--meta);
    text-align: center;
  }

  @media (min-width: 640px) {
    .shell {
      padding-inline: var(--container-gutter-tablet);
    }
    .head,
    .foot {
      padding-inline: var(--space-8);
    }
    h1 {
      font-size: var(--text-2xl);
      line-height: 36px;
    }
  }
</style>
