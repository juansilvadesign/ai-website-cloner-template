---
/**
 * DNE credential on `/student-card`. Spec: docs/research/fesn/components/student-card-found.spec.md
 *
 * MOCK DATA ONLY. The live route resolves a real student (name, photo, CPF, date of birth)
 * from a lookup; that payload is personally identifying and is never reproduced here.
 */
import type { StudentCard } from "../types/fesn";

interface Props {
  card: StudentCard;
}

const { card } = Astro.props;

const rows: Array<[string, string]> = [
  ["INST. DE ENSINO:", card.institution],
  ["CURSO:", card.course],
  ["TIPO DE CURSO:", card.courseType],
];

const rows2: Array<[string, string]> = [
  ["CPF:", card.cpf],
  ["DATA DE NASC:", card.birthDate],
  ["VALIDADE:", card.validUntil],
];
---

<main class="shell">
  <header class="head">
    <h1>MINHA CARTEIRINHA DE ESTUDANTE</h1>
  </header>

  <section class="col">
    <div class="logos">
      <img src="/clones/fesn/images/logo-dne-color.png" alt="Logo DNE" width="154" height="45" />
      <img src="/clones/fesn/images/logo-fesn-short.svg" alt="Logo FESN" width="154" height="50" />
    </div>

    <div class="media">
      <div class="photo">
        <img src={card.photoSrc} alt="Foto do estudante" width="300" height="400" />
      </div>
      <div class="qr">
        <div class="qr-img">
          <img src={card.qrSrc} alt="QR Code de autenticidade" width="256" height="256" />
        </div>
        <div class="qr-cap">
          <p>Nº DA CIE</p>
          <p>{card.cieCode}</p>
        </div>
      </div>
    </div>

    <div class="data">
      <div class="data-inner">
        <p class="name">{card.name}</p>
        <div class="sp10"></div>
        {rows.map(([k, v]) => <p><span class="k">{k}</span> <span>{v}</span></p>)}
        <div class="sp10"></div>
        {rows2.map(([k, v]) => <p><span class="k">{k}</span> <span>{v}</span></p>)}
        <div class="sp20"></div>
        <div class="year-row"><span class="year">{card.year}</span></div>
      </div>
    </div>

    <div class="fed">
      <p class="fed1">FEDERACAO DOS ESTUDANTES NACIONAL</p>
      <p class="fed2">Valide seu DNE em: validadordnefesn.org.br</p>
    </div>

    <a class="cert" href={`https://fesn.appcie.org/${card.cieCode}`}>
      <span class="tick">✓</span>
      <span>Certificado</span>
    </a>

    <a class="btn btn--primary again" href="/fesn/">Buscar outra carteirinha</a>
  </section>
</main>

<style>
  .shell {
    min-height: 100vh;
    overflow-y: auto;
    padding: 12px var(--container-gutter-phone) var(--space-5);
    background-color: rgb(214, 212, 236);
    background-image: url("/clones/fesn/images/bg-student-card-2026.png");
    background-size: cover;
    background-position: 50% 50%;
  }

  .head {
    width: 100%;
    max-width: 350px;
    margin-inline: auto;
    text-align: center;
  }

  h1 {
    font-size: 13px;
    font-weight: 700;
    line-height: 19.5px;
    color: #000000;
  }

  .col {
    width: 100%;
    max-width: 350px;
    margin-inline: auto;
    padding-top: var(--space-4);
  }

  .logos {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-8);
  }

  .logos img {
    width: 44%;
    height: auto;
    max-height: 50px;
    object-fit: contain;
  }

  .media {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-5);
  }

  .photo {
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    background: rgb(255 255 255 / 0.7);
    aspect-ratio: 3 / 4;
    width: 148px;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .qr {
    width: 46%;
    max-width: 160px;
    min-width: 132px;
    padding: var(--space-3);
    border-radius: 10px;
    background: #ffffff;
  }

  .qr-img {
    overflow: hidden;
    border-radius: 6px;
    background: rgb(255 255 255 / 0.7);
  }

  .qr-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .qr-cap {
    margin-top: var(--space-2);
    text-align: center;
    font-size: 11px;
    line-height: 15.125px;
    color: rgb(0 0 0 / 0.9);
  }

  .data {
    width: 100%;
    padding: var(--space-4);
    border-radius: 10px;
    background: #ffffff;
  }

  .data-inner {
    font-size: 11px;
    line-height: 15.125px;
    color: rgb(0 0 0 / 0.9);
  }

  .name {
    font-weight: 700;
  }

  .k {
    font-weight: 700;
  }

  .sp10 {
    height: 10px;
  }

  .sp20 {
    height: 20px;
  }

  .year-row {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;
  }

  .year {
    font-size: 22px;
    font-weight: 700;
    line-height: 30.25px;
    background-image: linear-gradient(to right, #3080ff 0%, #4f39f6 100%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .fed {
    padding-top: 10px;
    text-align: center;
    color: #000000;
  }

  .fed1 {
    font-size: 13px;
    line-height: 19.5px;
  }

  .fed2 {
    font-size: 10px;
    line-height: 15px;
  }

  .cert {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: var(--space-2);
    width: 100%;
    height: 40px;
    margin-top: var(--space-5);
    border-radius: 30px;
    background: #ffffff;
    color: #000000;
    font-size: var(--text-sm);
    line-height: 20px;
    text-decoration: none;
  }

  .tick {
    color: var(--success);
  }

  .again {
    width: 100%;
    margin-top: var(--space-4);
  }

  @media (min-width: 640px) {
    .shell {
      padding-inline: var(--space-4);
    }
    .logos {
      margin-bottom: 40px;
    }
    .qr,
    .data {
      padding: var(--space-5);
    }
  }
</style>
