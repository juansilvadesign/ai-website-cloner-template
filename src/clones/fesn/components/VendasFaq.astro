---
/**
 * FAQ accordion on `/vendas`. Spec: docs/research/fesn/components/vendas-faq.spec.md
 *
 * The target uses Radix `type="single" collapsible`. `<details name="faq">` reproduces
 * single-open AND collapsible natively, so this ships with zero client JavaScript.
 */
import Icon from "./Icon.astro";
import type { FaqItem } from "../types/fesn";

const items: FaqItem[] = [
  {
    question: "A carteirinha de estudante digital é válida para pagar meia-entrada?",
    answer:
      "Sim. A FESN é uma entidade autorizada para emissão de carteirinha estudantil, seja ela física ou digital.",
  },
  {
    question: "Posso usar a carteirinha digital em cinemas e shows?",
    answer:
      "Sim. A carteirinha digital pode ser apresentada no celular, com validação por QR Code para facilitar a conferência em eventos e estabelecimentos.",
  },
  {
    question: "Quanto tempo leva para receber a carteirinha digital?",
    answer:
      "Depois de enviar os dados no checkout e confirmar o pagamento, a análise acontece rapidamente e a liberação costuma sair em poucos minutos.",
  },
  {
    question: "É necessário comprovar matrícula?",
    answer:
      "Sim. Para manter a legitimidade do documento, a FESN pode solicitar comprovação de vínculo estudantil durante a emissão.",
  },
  {
    question: "Como a autenticidade da carteirinha é verificada?",
    answer:
      "A carteirinha possui QR Code e código de uso exclusivo. A conferência deve ser feita em ambiente oficial de validação.",
  },
  {
    question: "Meus dados pessoais estão protegidos?",
    answer:
      "A FESN adota boas práticas de segurança e tratamento responsável de dados para proteger as informações durante todo o processo.",
  },
];
---

<section class="section" id="faq">
  <h2>Perguntas frequentes sobre carteira de estudante digital</h2>
  <p class="intro">
    Reunimos as dúvidas mais comuns para ajudar você a decidir com segurança antes de solicitar sua
    carteirinha.
  </p>

  <div class="card">
    <div class="inner">
      {
        items.map((item) => (
          <details class="row" name="faq">
            <summary>
              <span>{item.question}</span>
              <Icon name="chevron-down" size={16} class="chev" />
            </summary>
            <div class="panel">
              <p>{item.answer}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .section {
    width: 100%;
    max-width: var(--container-max);
    margin-inline: auto;
    padding: 0 var(--container-gutter-phone) var(--section-y-tablet);
    scroll-margin-top: var(--space-6);
  }

  h2 {
    font-size: var(--text-xl);
    font-weight: 600;
    line-height: 32px;
    color: var(--fg);
  }

  .intro {
    max-width: 896px;
    margin-top: var(--space-3);
    font-size: var(--text-base);
    line-height: 24px;
    color: var(--fg-2);
  }

  .card {
    margin-top: var(--space-8);
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--elev-flat);
  }

  .inner {
    padding: var(--space-5);
  }

  .row {
    border-bottom: 1px solid var(--border-soft);
  }

  .row:last-child {
    border-bottom: 0;
  }

  summary {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--space-4);
    min-height: 56px;
    padding: var(--space-4) 0;
    border-radius: var(--radius-sm);
    font-size: var(--text-base);
    font-weight: 500;
    line-height: 24px;
    color: #0a0a0a;
    text-align: left;
    cursor: pointer;
    list-style: none;
    transition: color var(--motion-base) var(--ease-standard);
  }

  summary::-webkit-details-marker {
    display: none;
  }

  summary:hover {
    color: var(--accent);
  }

  .chev {
    flex: none;
    margin-top: 2px;
    transition: transform var(--motion-base) var(--ease-standard);
  }

  .row[open] .chev {
    transform: rotate(180deg);
  }

  /* Height animation without JS: 0fr → 1fr on a single-row grid. */
  .panel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows var(--motion-base) var(--ease-standard);
  }

  .row[open] .panel {
    grid-template-rows: 1fr;
  }

  .panel > p {
    min-height: 0;
    overflow: hidden;
    padding-bottom: var(--space-4);
    font-size: var(--text-sm);
    line-height: 20px;
    color: var(--muted);
  }

  @media (prefers-reduced-motion: reduce) {
    .panel,
    .chev {
      transition: none;
    }
  }

  @media (min-width: 640px) {
    .section {
      padding-inline: var(--container-gutter-tablet);
    }
    h2 {
      font-size: var(--text-2xl);
      line-height: 36px;
    }
    .inner {
      padding: var(--space-6);
    }
  }

  @media (min-width: 1024px) {
    .section {
      padding-bottom: var(--section-y-desktop);
    }
  }
</style>
