<section class="hero" aria-labelledby="hero-title">
  <div class="hero-pattern" aria-hidden="true"></div>

  <div class="container">
    <div class="hero-copy">
      <p class="eyebrow"><span aria-hidden="true"></span>Plataforma segura</p>
      <h1 id="hero-title">
        Consulta de processos por CPF e CNPJ para decisões <em>inteligentes</em>
      </h1>
