          width="350"
          height="400"
          loading="eager"
          decoding="async"
        />
        <figcaption>
          <strong>Marcos Blando</strong>
          <span>36 anos</span>
        </figcaption>
      </figure>

      <div class="status-card status-processes">
        <span class="status-icon status-icon-teal" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
