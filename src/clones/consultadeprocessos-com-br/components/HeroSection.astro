          </svg>
        </span>
        <span class="status-copy"><strong>3 processos</strong><small>criminais</small></span>
      </div>

      <div class="status-card status-pep">
        <span class="status-icon status-icon-coral" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
