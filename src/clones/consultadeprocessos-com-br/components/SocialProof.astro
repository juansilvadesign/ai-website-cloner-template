---
const stats = [
  ["+600", "Milhões", "de processos judiciais"],
  ["+250", "Milhões", "de dados de pessoas"],
  ["+60", "Milhões", "de dados de empresas"],
  ["+20", "Milhões", "de atualizações por dia"],
] as const;
const avatars = ["user1.webp", "user2.webp", "user4.webp", "user5.webp", "user6.webp"] as const;
---

<section class="social-proof" aria-labelledby="social-proof-title">
  <div class="social-proof__container">
    <div class="social-proof__quote">
      <div class="quote-stars" aria-hidden="true">{Array.from({ length: 5 }).map(() => <svg viewBox="0 0 20 20"><path d="m10 1 2.39 4.84 5.34.78-3.87 3.77.91 5.32L10 13.28l-4.77 2.51.91-5.32L2.27 6.7l5.34-.78L10 1Z" /></svg>)}</div>
      <blockquote id="social-proof-title">“É como ter acesso a múltiplas fontes de informação em um único lugar, disponível sempre que você precisar.”</blockquote>
      <div class="social-proof__people"><div>{avatars.map((avatar) => <img src={`/clones/consultadeprocessos-com-br/images/${avatar}`} alt="" loading="lazy" width="44" height="44" />)}</div><p>Utilizado por mais de 2.000 profissionais</p></div>
    </div>
    <div class="social-proof__stats">
      {stats.map(([value, label, description]) => <article><strong>{value}</strong><b>{label}</b><p>{description}</p></article>)}
    </div>
  </div>
</section>

<style>
  .social-proof { padding:var(--section-y-desktop) 0; background:color-mix(in srgb,var(--surface-warm) 60%,var(--surface)); }
  .social-proof__container { width:min(calc(100% - (var(--container-gutter-desktop) * 2)),896px); margin-inline:auto; }
  .social-proof__quote { min-height:300px; text-align:center; }
  .quote-stars { display:flex; justify-content:center; gap:4px; }
  .quote-stars svg { width:22px; height:22px; fill:var(--accent); }
  .social-proof blockquote { max-width:768px; margin:34px auto 44px; color:var(--fg); font-size:36px; font-weight:700; letter-spacing:var(--tracking-display); line-height:1.18; }
  .social-proof__people { display:grid; justify-items:center; gap:var(--space-2); }
  .social-proof__people > div { display:flex; padding-left:var(--space-2); }
  .social-proof__people img { width:44px; height:44px; margin-left:-8px; border:3px solid var(--surface); border-radius:var(--radius-pill); object-fit:cover; }
  .social-proof__people p { margin:0; color:var(--muted); font-size:var(--text-sm); }
  .social-proof__stats { display:grid; grid-template-columns:repeat(4,1fr); border:1px solid var(--border); border-radius:var(--radius-md); overflow:hidden; background:var(--surface); }
  .social-proof__stats article { min-height:159px; padding:32px 22px; border-right:1px solid var(--border); text-align:center; }
  .social-proof__stats article:last-child { border-right:0; }
  .social-proof__stats strong { display:block; color:var(--accent-hover); font-size:var(--text-xl); font-weight:700; line-height:1.1; }
  .social-proof__stats b { display:block; margin-top:4px; color:var(--fg); font-size:var(--text-sm); }
  .social-proof__stats p { margin:5px 0 0; color:var(--muted); font-size:var(--text-xs); line-height:1.35; }
  @media(max-width:1023px) { .social-proof { padding:var(--section-y-tablet) var(--container-gutter-tablet); } .social-proof__container { width:100%; } .social-proof blockquote { font-size:30px; } }
  @media(max-width:767px) { .social-proof { padding:var(--section-y-phone) var(--container-gutter-phone); } .social-proof__quote { min-height:272px; } .social-proof blockquote { margin:28px auto 36px; font-size:24px; line-height:1.3; } .social-proof__stats { grid-template-columns:repeat(2,1fr); } .social-proof__stats article { min-height:108px; padding:20px; border-bottom:1px solid var(--border); } .social-proof__stats article:nth-child(2n) { border-right:0; } .social-proof__stats article:nth-last-child(-n+2) { border-bottom:0; } .social-proof__stats strong { font-size:var(--text-lg); } }
</style>
