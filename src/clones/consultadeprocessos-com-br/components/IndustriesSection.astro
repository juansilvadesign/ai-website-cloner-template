---
const industries = [
  {
    id: "juridico",
    icon: "⚖",
    title: "Departamentos jurídicos",
    description: "Mais controle sobre processos. Menos trabalho manual. Centralize informações e antecipe riscos com dados atualizados.",
    benefits: [["Monitoramento em tempo real", "Alertas automáticos sobre movimentações relevantes."], ["Due diligence ágil", "Histórico completo de partes antes de decisões."], ["Visão consolidada", "Todos os processos em uma única tela."]],
  },
  {
    id: "recrutamento",
    icon: "◯",
    title: "Recrutamento e seleção",
    description: "Evite contratações de risco. Decida com dados reais. Vá além do currículo e valide o histórico do candidato.",
    benefits: [["Antecedentes judiciais", "Processos vinculados ao CPF do candidato."], ["Prevenção a fraudes", "Identifique inconsistências e sinais de risco."], ["Decisão mais segura", "Reduza custos com erros de contratação."]],
  },
  {
    id: "compliance",
    icon: "◇",
    title: "Compliance",
    description: "Reduza riscos com uma visão completa da operação. Analise clientes, parceiros e fornecedores com profundidade.",
    benefits: [["KYC e KYP", "Validação de clientes e parceiros com histórico judicial."], ["KYE e KYS", "Análise de colaboradores e fornecedores antes de decisões."], ["Detecção de riscos", "Identifique irregularidades e padrões suspeitos."]],
  },
  {
    id: "financeiro",
    icon: "↗",
    title: "Instituições financeiras",
    description: "Crédito mais seguro começa com informação completa. Enxergue riscos que o score não mostra.",
    benefits: [["Análise além do score", "Dados judiciais integrados à análise financeira."], ["Detecção de litigantes", "Perfis com histórico de ações recorrentes."], ["Prevenção a inadimplência", "Identifique sinais antes da aprovação."]],
  },
  {
    id: "logistica",
    icon: "▦",
    title: "Transportadoras e logística",
    description: "Mais segurança na contratação e operação. Reduza riscos com validação rápida de motoristas.",
    benefits: [["Antecedentes criminais", "Verificação rápida e confiável."], ["Redução de riscos", "Menos casos de roubo e problemas operacionais."], ["Verificação em escala", "Consultas simultâneas sem esforço manual."]],
  },
] as const;
---

<section class="industries" id="para-empresas" aria-labelledby="industries-title" data-industries>
  <div class="industries__container">
    <header class="industries__intro">
      <span class="eyebrow"><i></i>Para quem é</span>
      <h2 id="industries-title">Desenvolvido para profissionais que não aceitam incertezas</h2>
      <p>Cada segmento utiliza a plataforma de uma forma diferente. Veja como ela se adapta à sua rotina.</p>
    </header>
    <div class="industries__layout">
      <aside class="industry-rail" aria-label="Segmentos atendidos">
        <span class="industry-rail__track"></span><span class="industry-rail__progress" data-industry-progress></span>
        <div>
          {industries.map((industry, index) => <button type="button" data-industry-button data-target={industry.id} class:list={{ "is-active": index === 0 }}><span aria-hidden="true">{industry.icon}</span>{industry.title}</button>)}
        </div>
      </aside>
      <div class="industry-cards">
        {industries.map((industry) => (
          <article id={industry.id} class="industry-card" data-industry-card>
            <div class="industry-card__pattern" aria-hidden="true"><span>CPF ••• 432</span><span>TJSP</span><span>14:02:33</span><span>proc.7841</span><span>ativo</span><span>CNPJ ••• 91</span><span>2ª vara</span><span>tramitando</span></div>
            <div class="industry-card__content">
              <span class="industry-card__icon" aria-hidden="true">{industry.icon}</span>
              <h3>{industry.title}</h3>
              <p>{industry.description}</p>
              <ul>{industry.benefits.map(([title, description]) => <li><i aria-hidden="true">✓</i><span><strong>{title}</strong><small>{description}</small></span></li>)}</ul>
              <a href="#contato">Falar com especialista <span aria-hidden="true">→</span></a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const industries = document.querySelector<HTMLElement>("[data-industries]");
  if (industries) {
    const cards = [...industries.querySelectorAll<HTMLElement>("[data-industry-card]")];
    const buttons = [...industries.querySelectorAll<HTMLButtonElement>("[data-industry-button]")];
    const progress = industries.querySelector<HTMLElement>("[data-industry-progress]");

    const setActive = (index: number) => {
      buttons.forEach((button, buttonIndex) => button.classList.toggle("is-active", buttonIndex === index));
      if (progress) {
        progress.style.height = `${56}px`;
        progress.style.transform = `translateY(${index * 56}px)`;
      }
    };

    buttons.forEach((button, index) => {
      button.addEventListener("click", () => {
        cards[index]?.scrollIntoView({ behavior: "smooth", block: "center" });
        setActive(index);
      });
    });

    if (window.matchMedia("(min-width: 1024px)").matches && "IntersectionObserver" in window) {
      const observer = new IntersectionObserver((entries) => {
        const activeEntry = entries.filter((entry) => entry.isIntersecting).sort((a, b) => b.intersectionRatio - a.intersectionRatio)[0];
        if (activeEntry) setActive(cards.indexOf(activeEntry.target as HTMLElement));
      }, { rootMargin: "-36% 0px -44% 0px", threshold: [0.15, 0.4, 0.7] });
      cards.forEach((card) => observer.observe(card));
    }
  }
</script>

<style>
  .industries { padding:var(--section-y-tablet) 0 var(--section-y-desktop); background:var(--bg); }
  .industries__container { width:min(calc(100% - (var(--container-gutter-desktop) * 2)), 1152px); margin-inline:auto; }
  .industries__intro { max-width:768px; margin:0 auto 64px; text-align:center; }
  .eyebrow { display:inline-flex; align-items:center; gap:var(--space-2); color:var(--muted); font-size:var(--text-xs); font-weight:700; letter-spacing:.075em; text-transform:uppercase; }
  .eyebrow i { width:7px; height:7px; border-radius:2px; background:var(--meta); }
  .industries h2 { margin:var(--space-3) 0 0; color:var(--fg); font-size:42px; font-weight:700; letter-spacing:var(--tracking-display); line-height:var(--leading-tight); }
  .industries__intro p { max-width:672px; margin:var(--space-4) auto 0; color:var(--muted); font-size:var(--text-lg); line-height:1.6; }
  .industries__layout { display:grid; grid-template-columns:260px minmax(0,1fr); align-items:start; gap:64px; }
  .industry-rail { position:sticky; top:112px; min-height:280px; }
  .industry-rail__track, .industry-rail__progress { position:absolute; left:0; top:0; width:2px; border-radius:var(--radius-pill); }
  .industry-rail__track { bottom:0; background:var(--border); }
  .industry-rail__progress { height:56px; background:var(--accent); transition:transform 300ms var(--ease-standard); }
  .industry-rail > div { display:flex; flex-direction:column; padding-left:var(--space-5); }
  .industry-rail button { display:flex; height:56px; align-items:center; gap:var(--space-3); padding:0; border:0; background:transparent; color:var(--meta); font:inherit; font-size:var(--text-base); text-align:left; cursor:pointer; transition:color var(--motion-base) var(--ease-standard), font-weight var(--motion-base) var(--ease-standard); }
  .industry-rail button.is-active { color:var(--fg); font-weight:600; }
  .industry-rail button span { width:18px; text-align:center; }
  .industry-cards { display:grid; gap:112px; }
  .industry-card { position:relative; min-height:413px; overflow:hidden; border:1px solid var(--border-soft); border-radius:var(--radius-lg); background:var(--surface); box-shadow:var(--elev-ring); }
  .industry-card__pattern { position:absolute; top:0; right:0; bottom:0; display:grid; grid-template-columns:repeat(2, minmax(82px,1fr)); align-content:center; gap:13px; width:36%; padding:var(--space-6); color:color-mix(in srgb,var(--meta) 42%,transparent); font-size:10px; line-height:1; opacity:.36; }
  .industry-card__pattern::before { position:absolute; inset:0; background:linear-gradient(90deg,var(--surface),transparent); content:""; }
  .industry-card__pattern span { position:relative; padding:8px; border:1px solid var(--border-soft); border-radius:6px; background:color-mix(in srgb,var(--surface-warm) 70%,transparent); }
  .industry-card__content { position:relative; z-index:1; max-width:510px; padding:40px; }
  .industry-card__icon { display:grid; width:64px; height:64px; place-items:center; border:1px solid var(--border); border-radius:var(--radius-lg); background:var(--surface-warm); color:var(--accent-hover); font-size:var(--text-xl); font-weight:700; }
  .industry-card h3 { margin:var(--space-4) 0 var(--space-2); color:var(--fg); font-size:26px; font-weight:700; letter-spacing:var(--tracking-display); line-height:1.2; }
  .industry-card > .industry-card__content > p { margin:0; color:var(--muted); font-size:var(--text-base); line-height:1.55; }
  .industry-card ul { display:grid; gap:var(--space-3); margin:var(--space-5) 0; padding:0; list-style:none; }
  .industry-card li { display:flex; gap:var(--space-2); }
  .industry-card li > i { display:grid; flex:0 0 15px; width:15px; height:15px; place-items:center; margin-top:2px; border-radius:var(--radius-pill); background:color-mix(in srgb,var(--accent) 16%,var(--surface)); color:var(--accent-hover); font-size:9px; font-style:normal; font-weight:700; }
  .industry-card li span { display:grid; gap:1px; }
  .industry-card li strong { color:var(--fg-2); font-size:var(--text-sm); }
  .industry-card li small { color:var(--muted); font-size:var(--text-xs); line-height:1.4; }
  .industry-card a { display:inline-flex; align-items:center; gap:var(--space-2); color:var(--accent-hover); font-size:var(--text-sm); font-weight:700; }
  @media(max-width:1023px) { .industries { padding:var(--section-y-tablet) var(--container-gutter-tablet); } .industries__container { width:100%; } .industries h2 { font-size:36px; } .industries__layout { grid-template-columns:1fr; } .industry-rail { display:none; } .industry-cards { gap:var(--space-6); } }
  @media(max-width:767px) { .industries { padding:var(--section-y-phone) var(--container-gutter-phone); } .industries__intro { margin-bottom:40px; } .industries h2 { font-size:var(--text-2xl); } .industries__intro p { font-size:var(--text-base); } .industry-cards { gap:78px; } .industry-card { min-height:372px; } .industry-card__pattern { width:38%; padding:var(--space-3); font-size:8px; gap:6px; } .industry-card__content { max-width:100%; padding:28px 24px; } .industry-card__icon { width:48px; height:48px; border-radius:var(--radius-md); font-size:var(--text-lg); } .industry-card h3 { font-size:var(--text-xl); } .industry-card > .industry-card__content > p { font-size:var(--text-sm); } .industry-card ul { margin:var(--space-4) 0; gap:var(--space-2); } .industry-card li small { display:none; } }
</style>
