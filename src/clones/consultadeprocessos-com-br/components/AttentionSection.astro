---
const risks = [
  {
    number: "01",
    title: "Você pode estar assumindo riscos sem perceber",
    description:
      "Sem acesso ao histórico completo, decisões simples podem virar prejuízos.",
    icon: "!",
  },
  {
    number: "02",
    title: "Processos que você não está vendo",
    description:
      "Uma pessoa ou empresa pode ter ações em andamento que não aparecem em buscas comuns.",
    icon: "⌕",
  },
  {
    number: "03",
    title: "Risco financeiro invisível",
    description:
      "Dívidas, histórico judicial e comportamento podem impactar diretamente sua decisão.",
    icon: "R$",
  },
  {
    number: "04",
    title: "Parceiros sem verificação de idoneidade",
    description:
      "Fechar contratos sem consultar antecedentes pode expor sua empresa a fraudes e inadimplência.",
    icon: "✓",
  },
] as const;
---

<section class="attention-section" aria-labelledby="attention-title">
  <div class="attention-section__pattern" aria-hidden="true"></div>
  <div class="attention-section__container">
    <div class="attention-section__copy">
      <span class="eyebrow eyebrow--light"><i></i>Atenção</span>
      <h2 id="attention-title">Você pode estar fechando negócios com risco sem saber</h2>
      <p>
        Consulte processos, riscos e histórico completo de pessoas e empresas em segundos.
      </p>
      <a href="#cadastro" class="attention-section__cta">Consultar agora <span aria-hidden="true">→</span></a>
      <small>Utilizado por empresas em todo o Brasil</small>
    </div>

    <div class="risk-deck" data-risk-deck aria-label="Riscos que a plataforma identifica">
      <div class="risk-deck__cards">
        {risks.map((risk, index) => (
          <article class:list={["risk-card", { "is-active": index === 0 }]} data-risk-card data-index={index} style={`--deck-order: ${index}`}>
            <span class="risk-card__number">{risk.number}</span>
            <div class="risk-card__icon" aria-hidden="true">{risk.icon}</div>
            <div class="risk-card__copy">
              <h3>{risk.title}</h3>
              <p>{risk.description}</p>
            </div>
          </article>
        ))}
      </div>
      <div class="risk-deck__dots" aria-label="Selecionar risco">
        {risks.map((risk, index) => (
          <button type="button" data-risk-dot data-index={index} aria-label={`Mostrar risco ${risk.number}`} aria-current={index === 0 ? "true" : undefined}></button>
        ))}
      </div>
    </div>
  </div>
</section>

<script>
  const deck = document.querySelector<HTMLElement>("[data-risk-deck]");

  if (deck) {
    const cards = [...deck.querySelectorAll<HTMLElement>("[data-risk-card]")];
    const dots = [...deck.querySelectorAll<HTMLButtonElement>("[data-risk-dot]")];
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let active = 0;
    let timer: number | undefined;

    const render = (nextIndex: number) => {
      active = nextIndex;
      cards.forEach((card, index) => {
        const order = (index - active + cards.length) % cards.length;
        card.style.setProperty("--deck-order", String(order));
        card.classList.toggle("is-active", index === active);
      });
      dots.forEach((dot, index) => {
        const isActive = index === active;
        dot.toggleAttribute("aria-current", isActive);
      });
    };

    const stopTimer = () => {
      if (timer !== undefined) window.clearInterval(timer);
      timer = undefined;
    };

    const startTimer = () => {
      stopTimer();
      if (!reducedMotion.matches) {
        timer = window.setInterval(() => render((active + 1) % cards.length), 2800);
      }
    };

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        render(index);
        startTimer();
      });
    });

    reducedMotion.addEventListener("change", startTimer);
    render(0);
    startTimer();
  }
</script>

<style>
  .attention-section {
    position: relative;
    overflow: hidden;
    padding: var(--section-y-desktop) var(--space-8);
    background: linear-gradient(180deg, var(--accent), var(--accent-hover));
    color: var(--accent-on);
  }

  .attention-section__pattern {
    position: absolute;
    inset: 0;
    opacity: .06;
    background-image:
      linear-gradient(90deg, transparent 49%, rgba(255,255,255,.65) 50%, transparent 51%),
      linear-gradient(transparent 49%, rgba(255,255,255,.65) 50%, transparent 51%);
    background-size: 60px 60px;
    mask-image: radial-gradient(circle at 55% 52%, black, transparent 72%);
  }

  .attention-section__container {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 480px) minmax(460px, 500px);
    width: min(100%, calc(var(--container-max) - var(--space-6)));
    min-height: 415px;
    margin-inline: auto;
    align-items: center;
    justify-content: space-between;
    gap: clamp(var(--space-8), 10vw, 160px);
  }

  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 32px;
    padding: 0 var(--space-3);
    border-radius: var(--radius-pill);
    font-size: var(--text-xs);
    font-weight: 700;
    letter-spacing: .08em;
    text-transform: uppercase;
  }

  .eyebrow i {
    width: 7px;
    height: 7px;
    border-radius: 2px;
    background: currentColor;
  }

  .eyebrow--light { background: rgba(255,255,255,.12); color: var(--accent-on); }

  .attention-section h2 {
    max-width: 480px;
    margin: var(--space-5) 0 var(--space-4);
    font-size: clamp(var(--text-2xl), 3vw, 42px);
    font-weight: 700;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .attention-section__copy > p {
    max-width: 440px;
    margin: 0;
    color: color-mix(in srgb, var(--accent-on) 84%, transparent);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .attention-section__cta {
    display: inline-flex;
    min-height: 56px;
    margin-top: var(--space-6);
    align-items: center;
    gap: var(--space-3);
    padding-inline: 28px;
    border-radius: var(--radius-md);
    background: var(--surface);
    color: var(--accent-hover);
    font-size: var(--text-base);
    font-weight: 700;
    transition: background var(--motion-base) var(--ease-standard), transform var(--motion-fast) var(--ease-standard);
  }

  .attention-section__cta:hover { background: var(--surface-warm); transform: translateY(-1px); }
  .attention-section__cta:active { transform: translateY(0); }

  .attention-section small {
    display: block;
    margin-top: var(--space-4);
    color: color-mix(in srgb, var(--accent-on) 72%, transparent);
    font-size: var(--text-sm);
  }

  .risk-deck { width: 500px; }
  .risk-deck__cards { position: relative; height: 220px; }

  .risk-card {
    position: absolute;
    inset: 0 auto auto 0;
    display: flex;
    width: 500px;
    min-height: 220px;
    align-items: center;
    gap: var(--space-4);
    padding: 36px 28px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,.3);
    border-radius: var(--radius-lg);
    background: color-mix(in srgb, var(--accent-on) 10%, transparent);
    box-shadow: 0 20px 40px rgba(7, 91, 84, .16);
    opacity: calc(1 - (var(--deck-order) * .17));
    transform: translate(calc(var(--deck-order) * 15px), calc(var(--deck-order) * 15px)) scale(calc(1 - (var(--deck-order) * .04)));
    transform-origin: 52% 55%;
    transition: transform 300ms var(--ease-standard), opacity 300ms var(--ease-standard), background 300ms var(--ease-standard);
    z-index: calc(10 - var(--deck-order));
  }

  .risk-card.is-active { background: color-mix(in srgb, var(--accent-on) 14%, transparent); }

  .risk-card__number {
    position: absolute;
    top: 10px;
    right: 22px;
    color: rgba(255,255,255,.15);
    font-size: 80px;
    font-weight: 700;
    letter-spacing: -.08em;
    line-height: 1;
  }

  .risk-card__icon {
    display: grid;
    flex: 0 0 48px;
    width: 48px;
    height: 48px;
    place-items: center;
    border: 1px solid rgba(255,255,255,.36);
    border-radius: var(--radius-md);
    background: rgba(255,255,255,.12);
    color: var(--accent-on);
    font-size: var(--text-lg);
    font-weight: 700;
  }

  .risk-card__copy { position: relative; z-index: 1; }
  .risk-card__copy h3 { max-width: 370px; margin: 0; font-size: var(--text-xl); font-weight: 700; line-height: 1.35; }
  .risk-card__copy p { max-width: 420px; margin: var(--space-3) 0 0; color: rgba(255,255,255,.82); font-size: var(--text-base); line-height: 1.5; }

  .risk-deck__dots {
    display: flex;
    justify-content: center;
    gap: var(--space-2);
    margin-top: 34px;
  }

  .risk-deck__dots button {
    width: 6px;
    height: 6px;
    padding: 0;
    border: 0;
    border-radius: var(--radius-pill);
    background: rgba(255,255,255,.4);
    cursor: pointer;
    transition: width 300ms var(--ease-standard), background 300ms var(--ease-standard);
  }

  .risk-deck__dots button[aria-current="true"] { width: 24px; background: var(--accent-on); }

  @media (max-width: 1023px) {
    .attention-section { padding: var(--section-y-tablet) var(--container-gutter-tablet); }
    .attention-section__container { grid-template-columns: minmax(0, 1fr) minmax(0, 420px); gap: var(--space-8); }
    .risk-deck, .risk-card { width: 420px; }
  }

  @media (max-width: 767px) {
    .attention-section { padding: 56px var(--container-gutter-phone); }
    .attention-section__container { display: block; min-height: 626px; width: 100%; }
    .attention-section h2 { margin-top: var(--space-5); font-size: var(--text-2xl); }
    .attention-section__copy > p { font-size: var(--text-base); }
    .attention-section__cta { min-height: 48px; margin-top: var(--space-5); padding-inline: var(--space-5); font-size: var(--text-sm); }
    .attention-section small { margin-top: var(--space-4); }
    .risk-deck { width: 100%; margin-top: 62px; }
    .risk-deck__cards { height: 180px; }
    .risk-card { width: 100%; min-height: 180px; padding: 26px 20px; transform: translate(calc(var(--deck-order) * 10px), calc(var(--deck-order) * 10px)) scale(calc(1 - (var(--deck-order) * .04))); }
    .risk-card__number { right: 12px; font-size: 60px; }
    .risk-card__icon { flex-basis: 40px; width: 40px; height: 40px; font-size: var(--text-sm); }
    .risk-card__copy h3 { font-size: var(--text-base); line-height: 1.35; }
    .risk-card__copy p { margin-top: var(--space-2); font-size: var(--text-sm); }
    .risk-deck__dots { margin-top: 26px; }
  }
</style>
