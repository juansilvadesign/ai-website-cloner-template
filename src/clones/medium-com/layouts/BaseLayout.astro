---
import "@fontsource-variable/newsreader";
import "@fontsource-variable/newsreader/wght-italic.css";
import "@fontsource-variable/inter";
import "../styles/clone.css";

interface Props {
  title?: string;
  description?: string;
  canonical?: string;
  variant?: "marketing" | "product";
}

const {
  title = "Medium UI reconstruction",
  description = "A UI-only reconstruction of selected Medium routes.",
  canonical = "https://medium.com/",
  variant = "product",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content={variant === "marketing" ? "#f7f4ed" : "#ffffff"} />
    <meta name="color-scheme" content="light" />
    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/clones/medium-com/seo/favicon.svg" />
  </head>
  <body class:list={{ "medium-body": true, "medium-body--marketing": variant === "marketing" }}>
    <slot />
  </body>
</html>
