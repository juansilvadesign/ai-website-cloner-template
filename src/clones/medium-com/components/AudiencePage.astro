<section class="audience-page" data-audience-page>
  <div class="audience-page__heading"><div><h1>Your audience</h1><p>Updated daily</p></div><div><button type="button" data-audience-action="Partner Program earnings">Partner Program earnings</button><button type="button" data-audience-action="Story stats">Story stats</button></div></div>
  <p class="audience-page__notice" aria-live="polite" data-audience-notice>UI-only demo — the values below are sample data, not account data.</p>
  <div class="audience-page__metrics">
    <section><p>Followers <span title="More information">ⓘ</span></p><strong>1,240</strong><a href="#">+16 from last month</a></section>
    <section><p>Email subscribers <span title="More information">ⓘ</span></p><strong>284</strong><a href="#">+4 from last month</a><button type="button">View details</button></section>
    <section><p>Referred members <span title="More information">ⓘ</span></p><strong>18</strong><a href="#">+2 from last month</a></section>
  </div>
  <section class="audience-page__growth"><div><h2>Monthly growth</h2><p>Discover how your audience changes over time.</p></div><div class="audience-page__chart" aria-label="Sample monthly growth chart" role="img"><span>Aug</span><svg viewBox="0 0 600 180" preserveAspectRatio="none" aria-hidden="true"><path d="M0 148H600M0 90H600M0 32H600" class="audience-page__gridline"></path><polyline points="0,144 66,137 130,141 196,111 260,113 326,81 391,93 457,55 524,68 600,27" class="audience-page__line"></polyline><circle cx="600" cy="27" r="5"></circle></svg><span>Sep</span></div></section>
  <section class="audience-page__info"><h2>Build a reader relationship</h2><p>Audience tools work best when they sit behind the writing experience rather than competing with it. This static page recreates the dashboard hierarchy and controls only.</p></section>
</section>

<script>
  const audience = document.querySelector<HTMLElement>("[data-audience-page]");
  if (audience) {
    const notice = audience.querySelector<HTMLElement>("[data-audience-notice]");
    audience.querySelectorAll<HTMLButtonElement>("[data-audience-action]").forEach((button) => {
      button.addEventListener("click", () => { if (notice) notice.textContent = `${button.dataset.audienceAction} is represented as UI only.`; });
    });
  }
</script>

