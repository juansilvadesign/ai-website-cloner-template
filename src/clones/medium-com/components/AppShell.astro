---
interface Props {
  current?: "article" | "lists" | "audience";
}

const { current } = Astro.props;

const links = [
  { id: "home", label: "Home", href: "/medium-com/", icon: "home" },
  { id: "lists", label: "Library", href: "/medium-com/me/lists/", icon: "bookmark" },
  { id: "article", label: "Stories", href: "/medium-com/the-academic/floaties-not-shorelines-what-we-get-wrong-about-helping-someone-grieve-61d65dbddacf/", icon: "file" },
  { id: "audience", label: "Stats", href: "/medium-com/me/audience/", icon: "chart" },
];
---

<div class="app-shell">
  <header class="app-topbar">
    <a class="app-topbar__wordmark" href="/medium-com/" aria-label="Medium UI home">Medium</a>
    <label class="app-topbar__search">
      <span class="medium-visually-hidden">Search</span>
      <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.7" cy="10.7" r="6.7"></circle><path d="m16 16 4.3 4.3"></path></svg>
      <input type="search" placeholder="Search" />
    </label>
    <div class="app-topbar__actions">
      <a class="app-topbar__write" href="/medium-com/the-academic/floaties-not-shorelines-what-we-get-wrong-about-helping-someone-grieve-61d65dbddacf/"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l11-11-4-4L4 16v4Z"></path><path d="m13.7 6.3 4 4"></path></svg><span>Write</span></a>
      <button class="app-topbar__icon" type="button" aria-label="Notifications"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M18 10a6 6 0 0 0-12 0c0 7-3 7-3 9h18c0-2-3-2-3-9"></path><path d="M10 22h4"></path></svg></button>
      <a class="app-topbar__avatar" href="/medium-com/me/lists/" aria-label="Open profile">M</a>
    </div>
  </header>

  <aside class="app-rail" aria-label="Product navigation">
    <a class="app-rail__brand" href="/medium-com/" aria-label="Medium UI home"><span></span><i></i><b></b></a>
    <nav>
      {links.map((link) => (
        <a class:list={{ "app-rail__link": true, "is-active": current === link.id }} href={link.href} aria-current={current === link.id ? "page" : undefined} aria-label={link.label}>
          {link.icon === "home" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10Z"></path></svg>}
          {link.icon === "bookmark" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4V3Z"></path></svg>}
          {link.icon === "file" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18H6z"></path><path d="M9 8h6M9 12h6M9 16h4"></path></svg>}
          {link.icon === "chart" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20V8"></path></svg>}
          <span>{link.label}</span>
        </a>
      ))}
    </nav>
    <a class="app-rail__compose" href="/medium-com/the-academic/floaties-not-shorelines-what-we-get-wrong-about-helping-someone-grieve-61d65dbddacf/" aria-label="Write a story"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20h4l11-11-4-4L4 16v4Z"></path><path d="m13.7 6.3 4 4"></path></svg></a>
    <a class="app-rail__profile" href="/medium-com/me/lists/" aria-label="Profile">M</a>
  </aside>

  <main class="app-main"><slot /></main>

  <nav class="app-bottom-nav" aria-label="Product navigation mobile">
    {links.map((link) => (
      <a class:list={{ "app-bottom-nav__link": true, "is-active": current === link.id }} href={link.href} aria-current={current === link.id ? "page" : undefined}>
        {link.icon === "home" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10Z"></path></svg>}
        {link.icon === "bookmark" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18l-6-4-6 4V3Z"></path></svg>}
        {link.icon === "file" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M6 3h12v18H6z"></path><path d="M9 8h6M9 12h6M9 16h4"></path></svg>}
        {link.icon === "chart" && <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 20V10M10 20V4M16 20v-7M22 20V8"></path></svg>}
        <span>{link.label}</span>
      </a>
    ))}
  </nav>
</div>

<style>
  .app-shell { min-height: 100svh; padding-left: calc(var(--space-12) + var(--space-6)); background: var(--surface); }
  .app-topbar { position: fixed; z-index: 3; top: 0; right: 0; left: calc(var(--space-12) + var(--space-6)); display: flex; min-height: calc(var(--space-12) + var(--space-2)); align-items: center; border-bottom: 1px solid var(--border-soft); padding: 0 var(--space-6); background: color-mix(in srgb, var(--surface) 95%, transparent); backdrop-filter: blur(var(--space-2)); }
  .app-topbar__wordmark { display: none; color: var(--fg); font-family: var(--font-display); font-size: var(--text-xl); font-weight: 760; letter-spacing: var(--tracking-display); text-decoration: none; }
  .app-topbar__search { display: inline-flex; width: min(100%, 240px); height: calc(var(--space-8) + var(--space-2)); align-items: center; gap: var(--space-2); border-radius: var(--radius-pill); padding: 0 var(--space-4); background: var(--border-soft); color: var(--muted); }
  .app-topbar__search svg { width: var(--space-5); height: var(--space-5); fill: none; stroke: currentColor; stroke-width: 1.5; }
  .app-topbar__search input { width: 100%; border: 0; outline: 0; background: transparent; color: var(--fg); font-size: var(--text-sm); }
  .app-topbar__search input::placeholder { color: var(--muted); opacity: 1; }
  .app-topbar__actions { display: flex; align-items: center; gap: var(--space-4); margin-left: auto; }
  .app-topbar__write { display: inline-flex; align-items: center; gap: var(--space-2); color: var(--fg); font-size: var(--text-sm); text-decoration: none; }
  .app-topbar__write svg, .app-topbar__icon svg { width: var(--space-5); height: var(--space-5); fill: none; stroke: currentColor; stroke-width: 1.4; }
  .app-topbar__icon { display: grid; width: 40px; height: 40px; place-items: center; border: 0; border-radius: var(--radius-pill); background: transparent; color: var(--fg); }
  .app-topbar__icon:hover { background: var(--border-soft); }
  .app-topbar__avatar, .app-rail__profile { display: grid; width: var(--space-8); height: var(--space-8); place-items: center; border-radius: var(--radius-pill); background: var(--fg); color: var(--accent-on); font-size: var(--text-xs); font-weight: 720; text-decoration: none; }
  .app-rail { position: fixed; z-index: 4; inset: 0 auto 0 0; display: flex; width: calc(var(--space-12) + var(--space-6)); flex-direction: column; align-items: center; border-right: 1px solid var(--border); background: var(--surface); }
  .app-rail__brand { display: flex; width: 40px; height: calc(var(--space-12) + var(--space-2)); align-items: center; justify-content: center; gap: 2px; text-decoration: none; }
  .app-rail__brand span, .app-rail__brand i, .app-rail__brand b { display: block; border-radius: var(--radius-pill); background: var(--fg); }
  .app-rail__brand span { width: 18px; height: 18px; }
  .app-rail__brand i { width: 11px; height: 18px; }
  .app-rail__brand b { width: 5px; height: 18px; }
  .app-rail nav { display: grid; width: 100%; gap: var(--space-3); margin-top: var(--section-y-phone); }
  .app-rail__link { display: grid; width: 100%; min-height: 40px; place-items: center; color: var(--muted); text-decoration: none; }
  .app-rail__link svg, .app-bottom-nav__link svg { width: var(--space-6); height: var(--space-6); fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; stroke-width: 1.35; }
  .app-rail__link span { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
  .app-rail__link:hover, .app-rail__link.is-active { color: var(--fg); }
  .app-rail__link.is-active svg { fill: currentColor; }
  .app-rail__compose { display: grid; width: 40px; height: 40px; place-items: center; margin-top: auto; margin-bottom: var(--space-4); color: var(--muted); }
  .app-rail__compose svg { width: var(--space-6); height: var(--space-6); fill: none; stroke: currentColor; stroke-width: 1.35; }
  .app-rail__compose:hover { color: var(--fg); }
  .app-rail__profile { margin-bottom: var(--space-4); }
  .app-main { min-height: 100svh; padding: calc(var(--space-12) + var(--space-8)) var(--container-gutter-desktop) var(--section-y-desktop); }
  .app-bottom-nav { display: none; }
  @media (max-width: 900px) {
    .app-shell { padding-left: 0; }
    .app-rail { display: none; }
    .app-topbar { left: 0; }
    .app-topbar__wordmark { display: block; margin-right: var(--space-5); }
    .app-main { padding: calc(var(--space-12) + var(--space-12)) var(--container-gutter-tablet) calc(var(--section-y-tablet) + var(--space-12)); }
    .app-bottom-nav { position: fixed; z-index: 3; right: 0; bottom: 0; left: 0; display: grid; grid-template-columns: repeat(4, 1fr); min-height: calc(var(--space-12) + var(--space-4)); border-top: 1px solid var(--border); background: color-mix(in srgb, var(--surface) 95%, transparent); backdrop-filter: blur(var(--space-2)); }
    .app-bottom-nav__link { display: grid; place-content: center; gap: var(--space-1); color: var(--muted); font-size: var(--text-xs); text-align: center; text-decoration: none; }
    .app-bottom-nav__link svg { width: var(--space-5); height: var(--space-5); justify-self: center; }
    .app-bottom-nav__link.is-active { color: var(--fg); }
    .app-bottom-nav__link.is-active svg { fill: currentColor; }
  }
  @media (max-width: 520px) {
    .app-topbar { padding: 0 var(--container-gutter-phone); }
    .app-topbar__wordmark { font-size: var(--text-lg); }
    .app-topbar__search { display: none; }
    .app-topbar__write span { display: none; }
    .app-main { padding: calc(var(--space-12) + var(--space-8)) var(--container-gutter-phone) calc(var(--section-y-phone) + var(--space-12)); }
  }
</style>
