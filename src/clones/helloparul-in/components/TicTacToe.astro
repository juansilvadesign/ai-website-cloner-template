    line-height: 1.55;
  }

  .play-page__game {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    margin-top: 40px;
  }

  .play-page__status {
    min-height: 1.4em;
    margin: 0;
    color: var(--fg);
    font-family: "Space Mono", monospace;
    font-size: 15px;
    font-weight: 700;
  }

  .play-page__status[data-winner="X"] { color: #7cffb2; }
  .play-page__status[data-winner="O"] { color: var(--accent); }

  .play-page__board {
    display: grid;
    grid-template-columns: repeat(3, minmax(84px, 110px));
    grid-template-rows: repeat(3, minmax(84px, 110px));
    gap: 0;
    overflow: hidden;
    border: 3px solid var(--fg);
    border-radius: var(--radius-md);
    background: var(--fg);
  }

  .play-page__board button {
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1px solid color-mix(in srgb, var(--fg) 50%, transparent);
    background: var(--surface);
    color: var(--accent);
    cursor: pointer;
    font-family: var(--font-display);
    font-size: 44px;
    font-weight: 800;
    transition: background-color var(--motion-fast) var(--ease-standard);
  }

  .play-page__board button[data-mark="O"] { color: #1e37d8; }
  .play-page__board button:disabled { cursor: default; }

  .play-page__reset {
