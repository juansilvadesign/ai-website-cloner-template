    color: var(--muted);
    font-family: "Space Mono", monospace;
    font-size: var(--text-sm);
  }

  .play-page h1 {
    max-width: 18ch;
    margin: 0 0 16px;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: clamp(34px, 5.6vw, 58px);
    font-weight: 800;
    letter-spacing: var(--tracking-display);
    line-height: 1.02;
  }

  .play-page__intro {
    max-width: 56ch;
    margin: 0;
    color: var(--fg-2);
