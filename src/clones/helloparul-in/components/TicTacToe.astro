<main class="play-page parul-shell">
  <header>
    <p class="play-page__eyebrow">Let’s Play With Me</p>
    <h1>Tic-tac-toe, on the house.</h1>
    <p class="play-page__intro">A short break from case studies. You’re X, Parul is playing O — take turns and see who removes the last bit of friction.</p>
  </header>

  <section class="play-page__game" data-ttt aria-label="Tic-tac-toe game">
    <p class="play-page__status" aria-live="polite" data-ttt-status>Your turn (X)</p>
    <div class="play-page__board" role="group" aria-label="Tic-tac-toe board">
      {Array.from({ length: 9 }, (_, index) => <button type="button" aria-label={`Empty square ${index + 1}`} data-ttt-cell={index}></button>)}
    </div>
    <button class="play-page__reset" type="button" data-ttt-reset>Reset board ↺</button>
  </section>
</main>

<script>
  const game = document.querySelector<HTMLElement>("[data-ttt]");
  const status = game?.querySelector<HTMLElement>("[data-ttt-status]");
  const reset = game?.querySelector<HTMLButtonElement>("[data-ttt-reset]");
  const cells = [...(game?.querySelectorAll<HTMLButtonElement>("[data-ttt-cell]") ?? [])];
  const lines = [
    [0, 1, 2], [3, 4, 5], [6, 7, 8],
    [0, 3, 6], [1, 4, 7], [2, 5, 8],
    [0, 4, 8], [2, 4, 6],
  ];
  let board: Array<"X" | "O" | null> = Array(9).fill(null);
  let player: "X" | "O" = "X";
  let isComplete = false;

  const winner = () => lines.find(([a, b, c]) => board[a] && board[a] === board[b] && board[a] === board[c])?.map((index) => board[index])[0] ?? null;

  const setStatus = () => {
    const victor = winner();
    if (victor) {
      isComplete = true;
      if (status) {
        status.textContent = victor === "X" ? "You win! 🎉" : "Parul wins!";
        status.dataset.winner = victor;
      }
      return;
    }

    if (board.every(Boolean)) {
      isComplete = true;
      if (status) status.textContent = "It's a draw.";
      return;
    }

    if (status) {
      status.textContent = player === "X" ? "Your turn (X)" : "Parul is thinking…";
      status.removeAttribute("data-winner");
    }
  };

  const render = () => {
    cells.forEach((cell, index) => {
      const mark = board[index];
      cell.textContent = mark ?? "";
      cell.dataset.mark = mark ?? "";
      cell.setAttribute("aria-label", mark ? `Square ${index + 1}: ${mark}` : `Empty square ${index + 1}`);
      cell.disabled = Boolean(mark) || isComplete;
    });
  };

  const move = (index: number) => {
    if (board[index] || isComplete) return;
    board[index] = player;
    player = player === "X" ? "O" : "X";
    setStatus();
    render();
  };

  cells.forEach((cell, index) => cell.addEventListener("click", () => move(index)));
  reset?.addEventListener("click", () => {
    board = Array(9).fill(null);
    player = "X";
    isComplete = false;
    setStatus();
    render();
  });
</script>

<style>
