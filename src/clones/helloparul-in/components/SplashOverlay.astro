<div class="splash" aria-hidden="true" data-parul-splash>
  <img src="/clones/helloparul-in/images/splash-avatar.png" alt="" />
  <div class="splash__name">Parul Aggarwal</div>
  <div class="splash__caption">Politely arguing with a PM about spacing…</div>
  <div class="splash__track"><div class="splash__progress"></div></div>
</div>

<script>
  const splash = document.querySelector<HTMLElement>("[data-parul-splash]");

  window.setTimeout(() => {
    splash?.classList.add("is-leaving");
    window.setTimeout(() => splash?.remove(), 680);
  }, 6000);
</script>

<style>
  .splash {
    position: fixed;
    z-index: 9999;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 26px;
    background: var(--bg);
    opacity: 1;
    pointer-events: auto;
    transition:
      opacity 0.6s cubic-bezier(0.6, 0, 0.2, 1),
      transform 0.6s cubic-bezier(0.6, 0, 0.2, 1),
      filter 0.6s cubic-bezier(0.6, 0, 0.2, 1);
  }

  .splash.is-leaving {
    opacity: 0;
    pointer-events: none;
    transform: translateY(-3%);
    filter: blur(2px);
  }

  .splash img {
    width: 120px;
    height: 120px;
    object-fit: contain;
    animation: splash-bob 1.6s ease-in-out infinite;
  }

  .splash__name {
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 22px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .splash__caption {
    min-height: 20px;
    max-width: 88vw;
    color: var(--muted);
    font-family: "Space Mono", monospace;
    font-size: 13px;
    text-align: center;
  }

  .splash__track {
    width: 220px;
    height: 6px;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--fg) 12%, transparent);
  }

  .splash__progress {
    width: 100%;
    height: 100%;
    transform-origin: left;
    border-radius: inherit;
    background: var(--accent);
    animation: splash-progress 6s linear forwards;
  }

  @keyframes splash-progress {
    from { transform: scaleX(0); }
    to { transform: scaleX(1); }
  }

  @keyframes splash-bob {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }
</style>
