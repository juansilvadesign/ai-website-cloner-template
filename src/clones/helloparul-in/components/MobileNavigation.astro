---
interface Props {
  active?: "home" | "about" | "play";
}

const { active = "home" } = Astro.props;
---

<nav class="mobile-navigation" aria-label="Primary navigation">
  <a class:list={{ "is-active": active === "home" }} href="/helloparul-in/" aria-label="Home">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 11.5 12 4l9 7.5"></path><path d="M5.5 10v9a1 1 0 0 0 1 1H9a1 1 0 0 0 1-1v-4h4v4a1 1 0 0 0 1 1h2.5a1 1 0 0 0 1-1v-9"></path></svg>
  </a>
  <a href="/helloparul-in/#work" aria-label="Work">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="7" width="16" height="12" rx="2"></rect><path d="M9 7V5a2 2 0 0 1 2-2h2a2 2 0 0 1 2 2v2"></path><path d="M4 12h16"></path></svg>
  </a>
  <a class:list={{ "is-active": active === "about" }} href="/helloparul-in/about/" aria-label="About">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="8" r="3"></circle><path d="M5.5 21a6.5 6.5 0 0 1 13 0"></path></svg>
  </a>
  <a class:list={{ "is-active": active === "play" }} href="/helloparul-in/play/" aria-label="Play with Parul">
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="6" width="18" height="12" rx="3"></rect><path d="M8 10v4M6 12h4M16 11h.01M18 13h.01"></path></svg>
  </a>
</nav>

<style>
  .mobile-navigation {
    position: fixed;
    z-index: 70;
    right: 0;
    bottom: 0;
    left: 0;
    display: none;
    height: 56px;
    border-top: 2px solid var(--fg);
    background: var(--fg);
  }

  .mobile-navigation a {
    display: flex;
    flex: 1;
    align-items: center;
    justify-content: center;
    color: var(--accent-on);
  }

  .mobile-navigation a.is-active { color: #7cffb2; }

  @media (max-width: 760px) { .mobile-navigation { display: flex; } }
</style>
