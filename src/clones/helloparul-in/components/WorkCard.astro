---
interface Metric {
  value: string;
  label: string;
  tone?: "red" | "blue" | "ink";
}

interface Props {
  href: string;
  chips: readonly string[];
  title: string;
  description: string;
  emphasis?: string;
  metrics: readonly Metric[];
  image: string;
  imageAlt: string;
  reverse?: boolean;
}

const {
  href,
  chips,
  title,
  description,
  emphasis,
  metrics,
  image,
  imageAlt,
  reverse = false,
} = Astro.props;
---

<article class:list={["work-card", { "work-card--reverse": reverse }]}>
  <a href={href} aria-label={`Read ${title}`}>
    <div class="work-card__grid">
      <div class="work-card__copy">
        <div class="work-card__chips">
          {chips.map((chip, index) => <span class:list={{ "work-card__chip": true, "work-card__chip--client": index === 0 }}>{chip}</span>)}
        </div>
        <h3>{title}</h3>
        <p class="work-card__description">
          {emphasis ? (
            <>{description.slice(0, description.indexOf(emphasis))}<em>{emphasis}</em>{description.slice(description.indexOf(emphasis) + emphasis.length)}</>
          ) : description}
        </p>
        {metrics.length > 0 && (
          <div class="work-card__metrics">
            {metrics.map((metric) => (
              <div>
                <strong class={metric.tone ?? "ink"}>{metric.value}</strong>
                <span>{metric.label}</span>
              </div>
            ))}
          </div>
        )}
        <span class="work-card__prompt">Read the full case study →</span>
      </div>
      <div class="work-card__media">
        <img src={image} alt={imageAlt} loading="lazy" />
      </div>
    </div>
  </a>
</article>

<style>
  .work-card {
    overflow: hidden;
    margin-bottom: 28px;
    border: 2px solid var(--fg);
    border-radius: var(--radius-lg);
    background: var(--surface);
    transition: box-shadow var(--motion-fast) var(--ease-standard);
  }

  .work-card > a {
    display: block;
    color: inherit;
    text-decoration: none;
  }

  .work-card__grid {
    display: grid;
    grid-template-columns: 1.15fr .85fr;
  }

  .work-card--reverse .work-card__grid { grid-template-columns: .85fr 1.15fr; }
  .work-card--reverse .work-card__media { order: -1; }

  .work-card__copy { padding: 44px 44px 40px; }

  .work-card__chips {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-bottom: var(--space-6);
    font-family: "Space Mono", monospace;
    font-size: var(--text-sm);
  }

  .work-card__chip {
    padding: 6px 11px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
  }

  .work-card__chip--client {
    border-color: var(--fg);
    background: var(--fg);
    color: var(--accent-on);
  }

  .work-card h3 {
    margin: 0 0 18px;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: clamp(28px, 3.3vw, var(--text-2xl));
    font-weight: 800;
    letter-spacing: -0.025em;
    line-height: 1.02;
    text-wrap: balance;
  }

  .work-card__description {
    max-width: 48ch;
    margin: 0;
    color: var(--fg-2);
    font-size: var(--text-lg);
    line-height: var(--leading-body);
  }

  .work-card__description em { font-style: italic; }

  .work-card__metrics {
    display: flex;
    flex-wrap: wrap;
    gap: 34px;
    margin: 30px 0 var(--space-3);
  }

  .work-card__metrics strong {
    display: block;
    color: var(--fg);
    font-family: var(--font-display);
    font-size: 34px;
    font-weight: 800;
    letter-spacing: -0.02em;
  }

  .work-card__metrics strong.red { color: var(--accent); }
  .work-card__metrics strong.blue { color: #1e37d8; }

  .work-card__metrics span {
    display: block;
    color: var(--fg-2);
    font-family: "Space Mono", monospace;
    font-size: var(--text-xs);
  }

  .work-card__prompt {
    display: inline-flex;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-6);
    padding-bottom: 3px;
    border-bottom: 2px solid var(--accent);
    color: var(--fg);
    font-family: "Space Mono", monospace;
    font-size: var(--text-base);
    font-weight: 700;
  }

  .work-card__media {
    position: relative;
    display: flex;
    align-items: stretch;
    justify-content: center;
    overflow: hidden;
  }

  .work-card__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  @media (hover: hover) {
    .work-card:hover { box-shadow: var(--elev-raised); }
  }

  @media (max-width: 1024px) {
    .work-card__grid,
    .work-card--reverse .work-card__grid { grid-template-columns: 1fr; }

    .work-card--reverse .work-card__media { order: 2; }
  }

  @media (max-width: 760px) {
    .work-card__copy { padding: 30px 24px; }
    .work-card__description,
    .work-card__metrics { display: none; }

    .work-card__media img {
      width: 100%;
      height: auto;
      max-height: 480px;
      aspect-ratio: 1;
      object-fit: cover;
    }

    .work-card__prompt { margin-top: var(--space-6); }
  }
</style>
