---
import "../styles/clone.css";

interface Props {
  title: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
}

const {
  title,
  description = "Parul Aggarwal is a product designer focused on consumer products, growth, conversion, and removing friction.",
  canonical = "https://helloparul.in/",
  image = "/clones/helloparul-in/seo/favicon.png",
  type = "website",
} = Astro.props;

const resolvedImage = image.startsWith("http") ? image : new URL(image, Astro.url.origin).href;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,500;12..96,700;12..96,800&family=Instrument+Sans:wght@400;500;600&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />

    <title>{title}</title>
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Parul Aggarwal" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:image" content={resolvedImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedImage} />

    <link rel="icon" type="image/png" href="/clones/helloparul-in/seo/favicon.png" />
  </head>
  <body>
    <slot />
  </body>
</html>
