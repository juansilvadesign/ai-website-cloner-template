---
import ContactIcon from "./ContactIcon.astro";
import type { ContactAction } from "../types/contact";

const actions: ContactAction[] = [
  {
    label: "Salvar contato",
    subtitle: "Adicionar à agenda do celular",
    href: "/clones/fecoelho-com-br/fernanda-coelho.vcf",
    icon: "contact",
    arrow: "↓",
    primary: true,
    download: true,
  },
  {
    label: "WhatsApp",
    subtitle: "Mandar mensagem",
    href: "https://wa.me/5521998669695",
    icon: "whatsapp",
    arrow: "↗",
    external: true,
  },
  {
    label: "LinkedIn",
    subtitle: "fernanda-c-dreilich",
    href: "https://www.linkedin.com/in/fernanda-c-dreilich",
    icon: "linkedin",
    arrow: "↗",
    external: true,
  },
  {
    label: "Site",
    subtitle: "fecoelho.com.br",
    href: "https://fecoelho.com.br",
    icon: "website",
    arrow: "↗",
    external: true,
  },
  {
    label: "E-mail",
    subtitle: "fernandadreilich@gmail.com",
    href: "mailto:fernandadreilich@gmail.com",
    icon: "email",
    arrow: "↗",
  },
];
---

<nav class="links" aria-label="Meus contatos">
  {
    actions.map((action) => (
      <a
        class:list={["link", { primary: action.primary }]}
        href={action.href}
        download={action.download ? "" : undefined}
        target={action.external ? "_blank" : undefined}
        rel={action.external ? "noopener" : undefined}
      >
        <span class="ico" aria-hidden="true">
          <ContactIcon name={action.icon} />
        </span>
        <span class="txt">
          {action.label}
          <span class="sub">{action.subtitle}</span>
        </span>
        <span class="arr" aria-hidden="true">{action.arrow}</span>
      </a>
    ))
  }
</nav>

<style>
  .links {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .link {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding:
      calc(var(--space-5) + var(--space-1))
      calc(var(--space-5) + var(--space-2));
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    box-shadow: var(--elev-ring);
    color: var(--fg);
    font-size: var(--text-xl);
    font-weight: 600;
    transition:
      transform var(--motion-fast) var(--ease-standard),
      box-shadow var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard);
  }

  .link:active {
    transform: scale(0.985);
  }

  @media (hover: hover) {
    .link:hover {
      border-color: color-mix(in srgb, var(--accent) 45%, var(--border));
      box-shadow: var(--elev-raised);
    }
  }

  .ico {
    display: grid;
    flex: 0 0 var(--space-12);
    width: var(--space-12);
    height: var(--space-12);
    place-items: center;
    border-radius: var(--radius-sm);
    background: var(--surface-warm);
    color: var(--accent);
  }

  .txt {
    flex: 1;
    text-align: left;
  }

  .sub {
    display: block;
    margin-top: var(--space-1);
    color: var(--meta);
    font-size: var(--text-xs);
    font-weight: 400;
  }

  .arr {
    flex: 0 0 auto;
    color: var(--muted);
  }

  .link.primary {
    border-color: transparent;
    background: linear-gradient(
      135deg,
      var(--accent),
      color-mix(in srgb, var(--accent) 70%, var(--accent-hover))
    );
    color: var(--accent-on);
  }

  .primary .ico {
    background: rgb(255 255 255 / 0.18);
    color: var(--accent-on);
  }

  .primary .sub {
    color: color-mix(in srgb, var(--accent-on) 82%, transparent);
  }

  .primary .arr {
    color: color-mix(in srgb, var(--accent-on) 75%, transparent);
  }
</style>
