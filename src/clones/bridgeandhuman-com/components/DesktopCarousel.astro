---
import { stories } from "../data/stories";
---

<main class="bh-desktop" aria-label="Bridge & Human stories" data-bh-desktop>
  {stories.map((story, index) => (
    <article
      class:list={["bh-desktop__story", { "is-active": index === 0, "is-closing": story.closing }]}
      data-bh-story
      data-bh-story-index={index}
      aria-hidden={index === 0 ? "false" : "true"}
    >
      <div class="bh-desktop__editorial">
        <p class="bh-desktop__eyebrow">{story.eyebrow}</p>
        <h1 class="bh-desktop__title">
          {story.desktopTitle.map((line) => <span>{line}</span>)}
        </h1>
        {story.desktopMeta && (
          <p class="bh-desktop__meta">
            {story.desktopMeta.map((entry) => <span>{entry}</span>)}
          </p>
        )}
        {story.description && <p class="bh-desktop__description">{story.description}</p>}
      </div>

      <div class="bh-desktop__media">
        {story.media.type === "video" ? (
          <video
            src={story.media.src}
            poster={story.media.poster}
            autoplay
            loop
            muted
            playsinline
            aria-label={story.media.alt}
          />
        ) : (
          <>
            <img class="bh-desktop__media-background" src={story.media.src} alt="" />
            {story.media.overlay && <img class="bh-desktop__media-overlay" src={story.media.overlay} alt={story.media.alt} />}
          </>
        )}
        {story.media.overlay && story.media.type === "video" && (
          <img class="bh-desktop__media-logo" src={story.media.overlay} alt="" />
        )}
      </div>

      <a class="bh-desktop__primary" href={story.ctaHref} target="_blank" rel="noopener noreferrer">{story.ctaLabel}</a>
      <p class="bh-desktop__copyright">BRIDGE &amp; HUMAN © 2026</p>

      <div class:list={["bh-desktop__media-actions", { "bh-desktop__media-actions--one": story.desktopActions.length === 1 }]}>
        {story.desktopActions.map((action) => (
          <a href={action.href} target="_blank" rel="noopener noreferrer">{action.label}</a>
        ))}
      </div>
    </article>
  ))}
</main>

<style>
  .bh-desktop {
    position: relative;
    height: calc(100dvh - var(--section-y-desktop));
    min-height: 640px;
    overflow: hidden;
    background: var(--bg);
  }

  .bh-desktop__story {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transform: translateX(var(--space-3));
    transition:
      opacity var(--motion-base) var(--ease-standard),
      transform var(--motion-base) var(--ease-standard);
  }

  .bh-desktop__story.is-active {
    opacity: 1;
    pointer-events: auto;
    transform: translateX(0);
  }

  .bh-desktop__editorial {
    position: absolute;
    top: 64px;
    left: var(--container-gutter-desktop);
    width: calc(50% - var(--space-2));
  }

  .bh-desktop__eyebrow,
  .bh-desktop__description,
  .bh-desktop__meta,
  .bh-desktop__copyright {
    margin: 0;
  }

  .bh-desktop__eyebrow {
    font-family: "Bridge Plex Sans", var(--font-body);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.0232em;
    line-height: var(--leading-body);
  }

  .bh-desktop__title {
    max-width: 100%;
    margin: var(--space-2) 0 0;
    color: var(--fg-2);
    font-family: "Bridge Geist", var(--font-display);
    font-size: var(--text-4xl);
    font-weight: 400;
    letter-spacing: var(--tracking-display);
    line-height: var(--leading-tight);
  }

  .bh-desktop__title span { display: block; }

  .bh-desktop__description {
    max-width: 425px;
    margin-top: calc(var(--space-5) + var(--space-5) + var(--space-2));
    font-family: "Bridge Plex Sans", var(--font-body);
    font-size: var(--text-sm);
    line-height: var(--leading-body);
  }

  .bh-desktop__meta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-4);
    padding-left: var(--space-3);
    font-family: "Bridge Plex Mono", var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: var(--leading-body);
  }

  .bh-desktop__media {
    position: absolute;
    top: 128px;
    right: var(--container-gutter-desktop);
    bottom: var(--container-gutter-desktop);
    left: calc(50% + 10px);
    overflow: hidden;
    border-radius: var(--radius-lg);
    background: var(--surface-warm);
  }

  .bh-desktop__media video,
  .bh-desktop__media-background {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .bh-desktop__media-background { opacity: 0.92; }

  .bh-desktop__media-overlay {
    position: absolute;
    inset: 31% 16% auto;
    width: 68%;
    max-height: 46%;
    object-fit: contain;
  }

  .bh-desktop__media-logo {
    position: absolute;
    inset: auto 20% 32%;
    width: 60%;
    max-height: 18%;
    object-fit: contain;
  }

  .bh-desktop__primary,
  .bh-desktop__media-actions a {
    display: inline-flex;
    min-height: 72px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-md);
    font-family: "Bridge Plex Sans", var(--font-body);
    font-size: var(--text-lg);
    font-weight: 500;
    letter-spacing: -0.0228em;
    line-height: var(--leading-body);
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-standard);
  }

  .bh-desktop__primary {
    position: absolute;
    bottom: var(--container-gutter-desktop);
    left: var(--container-gutter-desktop);
    padding-inline: calc(var(--space-6) + var(--space-2));
    background: var(--accent);
    color: var(--accent-on);
  }

  .bh-desktop__primary:hover { background: var(--accent-hover); }

  .bh-desktop__copyright {
    position: absolute;
    right: calc(50% + var(--space-3));
    bottom: calc(var(--space-4) + var(--space-1));
    color: var(--fg);
    font-family: "Bridge Plex Mono", var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
    line-height: var(--leading-body);
  }

  .bh-desktop__media-actions {
    position: absolute;
    right: var(--space-5);
    bottom: 24px;
    left: calc(50% + 22px);
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: calc(var(--space-2) + (var(--space-1) / 2));
  }

  .bh-desktop__media-actions--one { grid-template-columns: minmax(0, 1fr); }

  .bh-desktop__media-actions a {
    padding-inline: var(--space-5);
    border: 1px solid color-mix(in srgb, var(--accent-on) 34%, transparent);
    background: color-mix(in srgb, var(--fg) 66%, transparent);
    color: var(--accent-on);
    backdrop-filter: blur(12px);
  }

  .bh-desktop__media-actions a:hover {
    background: color-mix(in srgb, var(--fg) 82%, transparent);
    transform: translateY(-2px);
  }

  .bh-desktop__story.is-closing .bh-desktop__title { max-width: 4.6ch; }
  .bh-desktop__story.is-closing .bh-desktop__description { margin-top: var(--space-4); }

  @media (max-width: 1023.98px) {
    .bh-desktop { display: none; }
  }
</style>

<script>
  const panels = Array.from(document.querySelectorAll<HTMLElement>("[data-bh-story]"));
  let activeIndex = 0;

  const setActiveStory = (nextIndex: number) => {
    if (panels.length === 0) return;
    activeIndex = (nextIndex + panels.length) % panels.length;
    panels.forEach((panel, index) => {
      const isActive = index === activeIndex;
      panel.classList.toggle("is-active", isActive);
      panel.setAttribute("aria-hidden", String(!isActive));
    });
    document.dispatchEvent(new CustomEvent("bh:story-index", { detail: { index: activeIndex, total: panels.length } }));
  };

  document.addEventListener("bh:story-change", ((event: Event) => {
    const direction = (event as CustomEvent<{ direction: number }>).detail.direction;
    setActiveStory(activeIndex + direction);
  }) as EventListener);

  setActiveStory(0);
</script>
