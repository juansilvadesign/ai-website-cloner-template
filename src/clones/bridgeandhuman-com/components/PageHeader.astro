---
import BrandLogo from "./BrandLogo.astro";

const date = new Intl.DateTimeFormat("en-US", {
  weekday: "long",
  month: "short",
  day: "numeric",
}).format(new Date());
---

<header class="bh-header">
  <div class="bh-header__desktop">
    <p class="bh-header__date">{date}</p>
    <div class="bh-header__brand"><BrandLogo /><span>Bridge &amp; Human</span></div>
    <div class="bh-header__controls" aria-label="Carousel navigation">
      <button type="button" data-bh-nav="-1" aria-label="Previous story">←</button>
      <button type="button" data-bh-nav="1" aria-label="Next story">→</button>
    </div>
  </div>
  <div class="bh-header__progress" aria-hidden="true"><span data-bh-progress></span></div>

  <div class="bh-header__mobile">
    <div class="bh-header__brand"><BrandLogo /><span>Bridge &amp; Human</span></div>
    <span class="bh-header__scroll">Scroll <span aria-hidden="true">↕</span></span>
  </div>
</header>

<style>
  .bh-header {
    position: relative;
    z-index: 20;
    background: var(--bg);
  }

  .bh-header__desktop {
    display: grid;
    min-height: var(--section-y-desktop);
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    padding-inline: var(--container-gutter-desktop);
  }

  .bh-header__date {
    margin: 0;
    font-family: "Bridge Plex Mono", var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 400;
    line-height: 1;
  }

  .bh-header__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 7px;
    color: var(--fg);
    font-family: "Bridge Plex Sans", var(--font-body);
    font-size: var(--text-base);
    font-weight: 500;
    letter-spacing: -0.0384em;
    line-height: var(--leading-body);
    white-space: nowrap;
  }

  .bh-header__controls {
    display: inline-flex;
    justify-content: end;
    gap: var(--space-2);
  }

  .bh-header__controls button {
    display: grid;
    width: 28px;
    height: 32px;
    place-items: center;
    border: 0;
    padding: 0;
    background: transparent;
    color: var(--fg);
    font-family: "Bridge Plex Sans", var(--font-body);
    font-size: var(--text-xl);
    font-weight: 300;
    letter-spacing: -0.0146em;
    line-height: 1;
  }

  .bh-header__progress {
    height: 1px;
    margin-inline: var(--container-gutter-desktop);
    background: var(--border-soft);
  }

  .bh-header__progress span {
    display: block;
    width: 14.2857%;
    height: 100%;
    background: var(--fg);
    transition: width var(--motion-base) var(--ease-standard);
  }

  .bh-header__mobile { display: none; }

  @media (max-width: 1023.98px) {
    .bh-header {
      position: fixed;
      inset: 0 0 auto;
      height: var(--section-y-phone);
      background: color-mix(in srgb, var(--bg) 70%, transparent);
      backdrop-filter: blur(20px);
    }

    .bh-header__desktop,
    .bh-header__progress { display: none; }

    .bh-header__mobile {
      display: flex;
      height: 100%;
      box-sizing: border-box;
      align-items: flex-start;
      justify-content: space-between;
      padding-inline: var(--container-gutter-phone);
      padding-top: var(--space-3);
    }

    .bh-header__scroll {
      color: var(--fg);
      font-size: var(--text-base);
      opacity: 0.45;
    }

    .bh-header__scroll span {
      margin-left: var(--space-1);
      font-size: var(--text-lg);
      vertical-align: -1px;
    }
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>("[data-bh-nav]");
  const progress = document.querySelector<HTMLElement>("[data-bh-progress]");

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const direction = Number(button.dataset.bhNav ?? "1");
      document.dispatchEvent(new CustomEvent("bh:story-change", { detail: { direction } }));
    });
  });

  document.addEventListener("bh:story-index", ((event: Event) => {
    const detail = (event as CustomEvent<{ index: number; total: number }>).detail;
    if (progress) progress.style.width = String(((detail.index + 1) / detail.total) * 100) + "%";
  }) as EventListener);
</script>
