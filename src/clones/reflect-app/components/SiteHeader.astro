---
import ReflectLogo from "./ReflectLogo.astro";

const nav = [
  { label: "Product", href: "/reflect-app/#connected" },
  { label: "Pricing", href: "/reflect-app/#pricing" },
  { label: "Company", href: "/reflect-app/#about" },
  { label: "Blog", href: "https://reflect.app/blog" },
  { label: "Changelog", href: "https://reflect.app/changelog" },
];
---

<header class="site-header" data-reflect-header>
  <div class="header-inner">
    <ReflectLogo />
    <nav aria-label="Primary navigation" class="desktop-nav">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-actions">
      <a class="login" href="https://reflect.app/auth">Login</a>
      <a class="trial" href="https://reflect.app/sign-up">Start free trial</a>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="reflect-mobile-menu" data-reflect-menu-toggle>
        <span class="reflect-sr-only">Open navigation</span>
        <span></span><span></span>
      </button>
    </div>
  </div>
  <nav id="reflect-mobile-menu" class="mobile-menu" aria-label="Mobile navigation" hidden data-reflect-mobile-menu>
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
    <a class="mobile-trial" href="https://reflect.app/sign-up">Start free trial</a>
  </nav>
</header>

<script>
  const header = document.querySelector<HTMLElement>("[data-reflect-header]");
  const toggle = header?.querySelector<HTMLButtonElement>("[data-reflect-menu-toggle]");
  const menu = header?.querySelector<HTMLElement>("[data-reflect-mobile-menu]");

  toggle?.addEventListener("click", () => {
    const open = toggle.getAttribute("aria-expanded") === "true";
    toggle.setAttribute("aria-expanded", String(!open));
    if (menu) menu.hidden = open;
  });

  menu?.querySelectorAll("a").forEach((item) => item.addEventListener("click", () => {
    toggle?.setAttribute("aria-expanded", "false");
    menu.hidden = true;
  }));
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 30;
    top: 0;
    left: 0;
    width: 100%;
    min-height: 88px;
    padding: 0 var(--space-5);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid color-mix(in srgb, var(--border) 40%, transparent);
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    min-height: 88px;
    max-width: 1296px;
    margin: 0 auto;
  }

  .desktop-nav {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    padding: var(--space-2) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    color: var(--fg-2);
    font-size: var(--text-sm);
    line-height: 20px;
  }

  .desktop-nav a,
  .login {
    transition: color var(--motion-base) var(--ease-standard);
  }

  .desktop-nav a:hover,
  .login:hover {
    color: var(--accent-hover);
  }

  .header-actions {
    display: flex;
    align-items: center;
    justify-content: end;
    gap: var(--space-6);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .trial,
  .mobile-trial {
    padding: var(--space-2) var(--space-4);
    border: 1px solid color-mix(in srgb, var(--accent-hover) 54%, transparent);
    border-radius: var(--radius-sm);
    background: linear-gradient(135deg, color-mix(in srgb, var(--accent-active) 70%, var(--bg)), color-mix(in srgb, var(--accent) 52%, var(--bg)));
    box-shadow: inset 0 0 12px color-mix(in srgb, var(--accent-hover) 25%, transparent);
    color: var(--accent-on);
    transition: background var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard);
  }

  .trial:hover,
  .mobile-trial:hover {
    border-color: var(--accent-hover);
    background: linear-gradient(135deg, var(--accent-active), var(--accent-hover));
  }

  .menu-toggle,
  .mobile-menu {
    display: none;
  }

  @media (max-width: 780px) {
    .site-header {
      min-height: 64px;
    }

    .header-inner {
      min-height: 64px;
      grid-template-columns: 1fr auto;
    }

    .desktop-nav,
    .login,
    .trial {
      display: none;
    }

    .header-actions {
      gap: var(--space-3);
    }

    .menu-toggle {
      display: grid;
      place-content: center;
      gap: 5px;
      width: 34px;
      height: 34px;
      border-radius: var(--radius-sm);
      background: transparent;
      color: var(--fg);
      cursor: pointer;
    }

    .menu-toggle span:not(.reflect-sr-only) {
      display: block;
      width: 18px;
      height: 1.5px;
      border-radius: var(--radius-pill);
      background: currentColor;
      transition: transform var(--motion-fast) var(--ease-standard);
    }

    .menu-toggle[aria-expanded="true"] span:nth-of-type(2) {
      transform: translateY(3.25px) rotate(45deg);
    }

    .menu-toggle[aria-expanded="true"] span:nth-of-type(3) {
      transform: translateY(-3.25px) rotate(-45deg);
    }

    .mobile-menu:not([hidden]) {
      display: grid;
      gap: var(--space-3);
      padding: var(--space-5);
      border-top: 1px solid var(--border);
      background: color-mix(in srgb, var(--surface) 90%, var(--bg));
      color: var(--fg-2);
      font-size: var(--text-sm);
    }

    .mobile-menu a:not(.mobile-trial) {
      padding: var(--space-2) 0;
    }

    .mobile-trial {
      justify-self: start;
    }
  }
</style>
