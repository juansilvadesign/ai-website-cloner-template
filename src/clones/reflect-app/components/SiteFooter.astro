---
import ReflectLogo from "./ReflectLogo.astro";

const groups = [
  { title: "Product", links: [["Features", "/reflect-app/#features"], ["Integrations", "/reflect-app/#integrations"], ["Pricing", "/reflect-app/#pricing"], ["Changelog", "https://reflect.app/changelog"], ["Roadmap", "https://reflect.academy/roadmap"]] },
  { title: "Company", links: [["Our team", "https://reflect.academy/our-team"], ["Our values", "https://reflect.academy/our-values"], ["Blog", "https://reflect.app/blog"]] },
  { title: "Resources", links: [["Downloads", "https://reflect.app/downloads"], ["Documentation", "https://reflect.academy/"], ["Contact", "https://reflect.academy/contact-us"]] },
];
---

<footer class="footer">
  <div class="footer-top">
    <div class="brand"><ReflectLogo /><div class="social"><a href="https://reflect.app/discord" aria-label="Our Discord server">◌</a><a href="https://twitter.com/reflectnotes" aria-label="Our Twitter account">𝕏</a></div></div>
    <div class="link-groups">{groups.map((group) => <section><h2>{group.title}</h2>{group.links.map(([label, href]) => <a href={href}>{label}</a>)}</section>)}</div>
    <form class="newsletter" action="#" onsubmit="return false"><h2>Join our newsletter</h2><p>Keep up to date with everything Reflect</p><label><span class="reflect-sr-only">Enter your email</span><input type="email" placeholder="Enter your email" /><button type="submit">Subscribe</button></label></form>
  </div>
  <div class="footer-bottom"><nav><a href="https://reflect.app/privacy">Privacy Policy</a><span>·</span><a href="https://reflect.app/terms">Terms of Conditions</a></nav><p>Reflect App, LLC. All rights reserved.</p></div>
</footer>

<style>
  .footer { position: relative; padding: 0 var(--space-8); border-top: 1px solid var(--border); background: radial-gradient(ellipse at 50% 0%, color-mix(in srgb, var(--accent-hover) 9%, transparent), transparent 46%), var(--bg); }.footer-top { display: grid; grid-template-columns: 1.1fr 1.6fr 1.2fr; gap: var(--space-8); width: min(1296px, 100%); margin: 0 auto; padding: 74px 0 var(--space-12); }.brand { display: grid; align-content: space-between; gap: var(--space-8); }.social { display: flex; gap: var(--space-3); }.social a { display: grid; place-items: center; width: 28px; height: 28px; border: 1px solid var(--border); border-radius: var(--radius-pill); color: var(--meta); font-size: var(--text-sm); transition: color var(--motion-base) var(--ease-standard), border-color var(--motion-base) var(--ease-standard); }.social a:hover { border-color: var(--accent-hover); color: var(--fg); }.link-groups { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-5); }.link-groups section { display: grid; align-content: start; gap: var(--space-3); }.link-groups h2, .newsletter h2 { margin: 0 0 var(--space-2); color: var(--fg-2); font-size: var(--text-sm); font-weight: 500; line-height: 20px; }.link-groups a, .newsletter p, .footer-bottom { color: var(--meta); font-size: var(--text-sm); line-height: 20px; }.link-groups a:hover { color: var(--fg); }.newsletter h2 { font-family: "Reflect Aeonik", var(--font-display); font-size: var(--text-lg); font-weight: 500; line-height: 32px; }.newsletter p { margin: 0; }.newsletter label { display: flex; margin-top: var(--space-5); padding-left: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-sm); background: color-mix(in srgb, var(--fg) 3%, transparent); }.newsletter input { width: 100%; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--fg); font-size: var(--text-sm); }.newsletter input::placeholder { color: var(--meta); }.newsletter button { flex: 0 0 auto; margin: 3px; padding: var(--space-2) var(--space-3); border-radius: 6px; background: color-mix(in srgb, var(--fg) 5%, transparent); color: var(--fg); cursor: pointer; font-size: var(--text-sm); }.newsletter button:hover { background: color-mix(in srgb, var(--accent) 35%, var(--surface)); }.footer-bottom { display: flex; justify-content: space-between; gap: var(--space-5); width: min(1296px, 100%); margin: 0 auto; padding: var(--space-6) 0; border-top: 1px solid var(--border-soft); }.footer-bottom nav { display: flex; gap: var(--space-3); }.footer-bottom a:hover { color: var(--fg); }.footer-bottom p { margin: 0; }
  @media (max-width: 960px) { .footer-top { grid-template-columns: 1fr 1.5fr; }.newsletter { grid-column: 1 / -1; max-width: 420px; } }
  @media (max-width: 640px) { .footer { padding: 0 var(--space-5); }.footer-top, .link-groups { grid-template-columns: 1fr; }.footer-top { padding-top: var(--section-y-phone); }.link-groups { gap: var(--space-8); }.footer-bottom { align-items: start; flex-direction: column; }.newsletter { grid-column: auto; } }
</style>
