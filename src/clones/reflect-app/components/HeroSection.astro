<section class="hero" aria-labelledby="reflect-hero-title">
  <div class="hero-orbits" aria-hidden="true">
    <span class="orbit orbit-one"></span><span class="orbit orbit-two"></span><span class="orbit orbit-three"></span>
    <span class="star star-a"></span><span class="star star-b"></span><span class="star star-c"></span><span class="star star-d"></span>
  </div>
  <div class="hero-copy">
    <a class="eyebrow" href="/reflect-app/#ai"><span aria-hidden="true">✦</span> New: Our AI integration just landed</a>
    <h1 id="reflect-hero-title">Think better with Reflect</h1>
    <p>Never miss a note, idea or connection.</p>
  </div>
  <div class="black-hole" aria-hidden="true"><div class="black-hole-core"></div></div>
  <div class="hero-demo">
    <img src="/clones/reflect-app/images/hero-preview.png" alt="Reflect note editor and April 2023 calendar preview" width="2400" height="1500" />
    <button type="button" class="play" aria-label="Play Reflect product video" data-reflect-video-open><span></span></button>
  </div>
</section>

<dialog class="video-modal" data-reflect-video-dialog aria-label="Reflect product video">
  <button type="button" class="close" aria-label="Close video" data-reflect-video-close>×</button>
  <video controls playsinline poster="/clones/reflect-app/images/hero-preview.png" data-reflect-video>
    <source src="/clones/reflect-app/videos/hero-demo.webm" type="video/webm" />
  </video>
</dialog>

<script>
  const open = document.querySelector<HTMLButtonElement>("[data-reflect-video-open]");
  const close = document.querySelector<HTMLButtonElement>("[data-reflect-video-close]");
  const dialog = document.querySelector<HTMLDialogElement>("[data-reflect-video-dialog]");
  const video = document.querySelector<HTMLVideoElement>("[data-reflect-video]");

  open?.addEventListener("click", () => {
    dialog?.showModal();
    void video?.play().catch(() => undefined);
  });

  const dismiss = () => {
    video?.pause();
    dialog?.close();
  };

  close?.addEventListener("click", dismiss);
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dismiss();
  });
</script>

