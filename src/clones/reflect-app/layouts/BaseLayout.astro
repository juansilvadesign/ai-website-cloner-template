---
import "../styles/clone.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Reflect Notes",
  description = "A beautifully minimalist note-taking app designed to mirror the way you think. Now with a native AI integration.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#030014" />
    <meta name="description" content={description} />
    <meta property="og:title" content="Reflect" />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://site.reflect.app/home/build/q-11289093.jpeg" />
    <meta property="og:url" content="https://reflect.app/" />
    <meta name="twitter:card" content="summary_large_image" />
    <title>{title}</title>
    <link rel="icon" type="image/png" sizes="36x36" href="/clones/reflect-app/seo/favicon.png" />
    <link rel="apple-touch-icon" href="/clones/reflect-app/seo/apple-touch-icon.png" />
    <link rel="canonical" href="https://reflect.app/" />
  </head>
  <body>
    <slot />
  </body>
</html>
