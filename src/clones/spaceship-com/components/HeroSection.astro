<section class="sp-hero" id="domains" data-mode="register">
  <div class="sp-hero__scene" aria-hidden="true">
    <img class="sp-hero__wash sp-hero__wash--register" src="/clones/spaceship-com/images/hero-register.webp" alt="" />
    <img class="sp-hero__wash sp-hero__wash--transfer" src="/clones/spaceship-com/images/hero-transfer.webp" alt="" />
    <img class="sp-hero__figure sp-hero__figure--primary" src="/clones/spaceship-com/images/hero-primary-figure.webp" alt="" />
    <img class="sp-hero__figure sp-hero__figure--secondary" src="/clones/spaceship-com/images/hero-secondary-figure.webp" alt="" />
  </div>

  <div class="sp-shell sp-hero__content">
    <div class="sp-hero__main">
      <h1><span>A domain</span> <span>odyssey</span></h1>
      <div class="sp-domain-tabs" role="group" aria-label="Domain search mode">
        <button type="button" data-domain-mode="register" aria-pressed="true">Register</button>
        <button type="button" data-domain-mode="transfer" aria-pressed="false">Transfer</button>
      </div>

      <form class="sp-domain-search" id="sp-domain-search">
        <label class="sp-sr-only" for="sp-domain-input">Search for a domain name</label>
        <input id="sp-domain-input" type="search" placeholder="Search for a domain name…" autocomplete="off" />
        <button class="sp-beast-mode" type="button" aria-pressed="false" id="sp-beast-mode"><span aria-hidden="true">✦</span> Beast Mode</button>
        <button class="sp-search-submit" type="submit" aria-label="Search domain"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="10.8" cy="10.8" r="5.8" fill="none" stroke="currentColor" stroke-width="2"/><path d="m15.3 15.3 4.4 4.4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg></button>
      </form>
      <p class="sp-search-status" id="sp-search-status" aria-live="polite"></p>

      <div class="sp-offers" aria-label="Domain offers">
        <a href="#products"><strong>.com</strong> only <b>$8.88</b><span>/yr</span></a>
        <a href="#products"><strong>.net</strong> only <b>$11.20</b><span>/yr</span></a>
      </div>
    </div>

    <a class="sp-builder-card" href="#products">
      <span class="sp-builder-card__eyebrow">AI WEBSITE BUILDER</span>
      <span class="sp-builder-card__content"><strong>Build your website</strong><small>Your online presence with no setup fees.</small></span>
      <span class="sp-builder-card__action">Start building <b aria-hidden="true">↗</b></span>
    </a>
  </div>
</section>

<script>
  const hero = document.querySelector<HTMLElement>(".sp-hero");
  const modeButtons = document.querySelectorAll<HTMLButtonElement>("[data-domain-mode]");
  const beastMode = document.querySelector<HTMLButtonElement>("#sp-beast-mode");
  const searchForm = document.querySelector<HTMLFormElement>("#sp-domain-search");
  const domainInput = document.querySelector<HTMLInputElement>("#sp-domain-input");
  const searchStatus = document.querySelector<HTMLElement>("#sp-search-status");

  modeButtons.forEach((button) => {
    button.addEventListener("click", () => {
      const mode = button.dataset.domainMode;
      if (!hero || !mode) return;
      hero.dataset.mode = mode;
      modeButtons.forEach((item) => item.setAttribute("aria-pressed", String(item === button)));
      if (domainInput) domainInput.placeholder = mode === "transfer" ? "Enter a domain to transfer…" : "Search for a domain name…";
    });
  });

  beastMode?.addEventListener("click", () => {
    const pressed = beastMode.getAttribute("aria-pressed") === "true";
    beastMode.setAttribute("aria-pressed", String(!pressed));
  });

  searchForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const query = domainInput?.value.trim();
    if (!searchStatus) return;
    searchStatus.textContent = query ? `Domain search ready for ${query}` : "Enter a domain name to start your search.";
  });
</script>

<style>
  .sp-hero {
    position: relative;
    min-height: 175vh;
    overflow: hidden;
    background: var(--bg);
    isolation: isolate;
  }

  .sp-hero__scene,
  .sp-hero__scene::after { position: absolute; inset: 0; }
  .sp-hero__scene { position: sticky; z-index: 0; top: 0; height: 100svh; margin-bottom: -100svh; overflow: hidden; }
  .sp-hero__scene::after { background: linear-gradient(180deg, color-mix(in srgb, var(--accent-active), var(--bg) 42%) 0%, transparent 20%, transparent 67%, var(--bg) 100%); content: ""; }

  .sp-hero__wash,
  .sp-hero__figure { position: absolute; inset: -8%; width: 116%; height: 116%; object-fit: cover; transition: opacity var(--motion-base) var(--ease-standard); }
  .sp-hero__wash--register { opacity: 1; }
  .sp-hero__wash--transfer { opacity: 0; }
  .sp-hero__figure { inset: -10%; z-index: 1; width: 120%; height: 120%; max-width: none; object-fit: contain; object-position: bottom; pointer-events: none; transform: translateY(-9%); }
  .sp-hero[data-mode="transfer"] .sp-hero__wash--register { opacity: 0; }
  .sp-hero[data-mode="transfer"] .sp-hero__wash--transfer { opacity: 1; }

  .sp-hero__content {
    position: relative;
    z-index: 2;
    min-height: 900px;
    display: grid;
    align-content: center;
    justify-items: center;
    padding-top: clamp(104px, 16vh, 180px);
    padding-bottom: clamp(154px, 21vh, 230px);
  }

  .sp-hero__main { width: min(100%, 690px); text-align: center; transform: translateY(54px); }
  h1 { margin: 0; font-family: var(--font-display); font-size: clamp(52px, 4.4vw, 64px); font-weight: 700; letter-spacing: var(--tracking-display); line-height: .96; }

  .sp-domain-tabs {
    width: max-content;
    display: flex;
    gap: 4px;
    margin: var(--space-8) auto var(--space-4);
    padding: 4px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: color-mix(in srgb, var(--bg), transparent 22%);
    box-shadow: var(--elev-ring);
  }

  .sp-domain-tabs button {
    min-height: 40px;
    padding: 8px var(--space-5);
    border: 0;
    border-radius: var(--radius-pill);
    background: transparent;
    color: var(--muted);
    font-size: var(--text-sm);
    font-weight: 700;
    transition: background-color var(--motion-fast) var(--ease-standard), color var(--motion-fast) var(--ease-standard);
  }

  .sp-domain-tabs button[aria-pressed="true"] { background: var(--fg); color: var(--bg); }

  .sp-domain-search {
    min-height: 64px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2);
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface);
    box-shadow: var(--elev-raised);
  }

  .sp-domain-search input { min-width: 0; padding: 0 var(--space-4); border: 0; outline: 0; background: transparent; color: var(--fg); font-size: var(--text-base); }
  .sp-domain-search input::placeholder { color: var(--muted); opacity: 1; }

  .sp-beast-mode {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border: 1px solid var(--border);
    border-radius: var(--radius-pill);
    background: var(--surface-warm);
    color: var(--fg);
    font-size: var(--text-xs);
    font-weight: 700;
  }

  .sp-beast-mode[aria-pressed="true"] { border-color: var(--accent); background: var(--accent-active); }
  .sp-beast-mode span { color: var(--accent); }
  .sp-beast-mode[aria-pressed="true"] span { color: var(--accent-on); }

  .sp-search-submit { width: 48px; height: 48px; display: grid; place-items: center; padding: 0; border: 0; border-radius: 50%; background: var(--accent); color: var(--accent-on); transition: background-color var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard); }
  .sp-search-submit:hover { background: var(--accent-hover); transform: scale(1.04); }
  .sp-search-submit svg { width: 20px; height: 20px; }

  .sp-search-status { min-height: 22px; margin: var(--space-2) 0 0; color: var(--fg); font-size: var(--text-xs); }
  .sp-offers { display: flex; justify-content: center; flex-wrap: wrap; gap: var(--space-2); margin-top: var(--space-2); }
  .sp-offers a { display: inline-flex; gap: 5px; align-items: baseline; padding: 7px 10px; border: 1px solid var(--border-soft); border-radius: var(--radius-pill); background: color-mix(in srgb, var(--bg), transparent 30%); font-size: var(--text-xs); }
  .sp-offers strong { color: var(--accent-on); }
  .sp-offers b { color: var(--accent-on); }
  .sp-offers span { color: var(--muted); }

  .sp-builder-card {
    position: absolute;
    bottom: 140px;
    width: min(calc(100% - (var(--space-6) * 2)), 680px);
    min-height: 104px;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: center;
    gap: var(--space-4);
    padding: var(--space-5) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--surface), transparent 16%);
    backdrop-filter: blur(18px);
    box-shadow: var(--elev-raised);
    transition: transform var(--motion-base) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard);
  }

  .sp-builder-card:hover { transform: translateY(-4px); border-color: color-mix(in srgb, var(--fg), transparent 60%); }
  .sp-builder-card__eyebrow { position: absolute; top: var(--space-4); left: var(--space-6); color: color-mix(in srgb, var(--fg), transparent 40%); font-size: var(--text-xs); font-weight: 700; letter-spacing: .16em; }
  .sp-builder-card__content { display: grid; gap: 3px; margin-top: var(--space-4); }
  .sp-builder-card__content strong { font-size: var(--text-lg); line-height: 1.1; }
  .sp-builder-card__content small { color: var(--muted); font-size: var(--text-sm); }
  .sp-builder-card__action { display: grid; gap: 4px; color: var(--fg); font-size: var(--text-xs); font-weight: 700; text-align: right; }
  .sp-builder-card__action b { color: var(--accent); font-size: var(--text-lg); }

  @media (min-width: 701px) and (max-height: 1000px) {
    .sp-hero__main { transform: translateY(-24px); }
    .sp-hero__figure { transform: translateY(24%); }
  }

  @media (max-width: 700px) {
    .sp-hero { min-height: 760px; }
    .sp-hero__content { min-height: 760px; padding-top: 64px; padding-bottom: 176px; }
    .sp-hero__main { transform: none; }
    .sp-hero__figure { inset: -12%; width: 124%; height: 124%; transform: none; }
    h1 { font-size: clamp(52px, 15vw, var(--text-4xl)); }
    h1 span { display: block; }
    .sp-domain-search { grid-template-columns: 1fr auto; }
    .sp-domain-search input { grid-column: 1 / -1; min-height: 40px; }
    .sp-beast-mode { justify-self: start; }
    .sp-search-submit { justify-self: end; }
    .sp-builder-card { bottom: var(--space-6); min-height: 88px; padding: var(--space-4); }
    .sp-builder-card__content strong { font-size: var(--text-base); }
    .sp-builder-card__content small { font-size: var(--text-xs); }
    .sp-builder-card__eyebrow { display: none; }
  }
</style>
