---
const steps = [
  { id: "choose", number: "01", title: "Choose", copy: "Select the extra products you need alongside your domain." },
  { id: "connect", number: "02", title: "Connect", copy: "Bring everything together into one easily manageable solution." },
  { id: "configure", number: "03", title: "Configure", copy: "Tailor your products and setup to meet your specific needs." },
  { id: "create", number: "04", title: "Create", copy: "You’re done and ready to build, launch, and grow your ideas." },
];
---

<section class="sp-unbox sp-section" id="unbox">
  <div class="sp-shell">
    <div class="sp-unbox__intro">
      <p class="sp-eyebrow">Unbox™</p>
      <h2 class="sp-display">Bring it all together</h2>
      <p class="sp-copy">Unbox automatically activates as part of your purchase setup, swiftly getting your products ready to launch and manage.</p>
      <a class="sp-button sp-button--text" href="#features">Discover more</a>
    </div>

    <div class="sp-unbox__story">
      <div class="sp-unbox__steps" role="tablist" aria-label="Unbox setup steps">
        {steps.map((step, index) => (
          <button type="button" role="tab" data-unbox-step={step.id} aria-selected={index === 0 ? "true" : "false"} aria-controls="sp-unbox-detail">
            <span>{step.number}</span><strong>{step.title}</strong>
          </button>
        ))}
      </div>
      <div class="sp-unbox__visual" aria-hidden="true">
        <div class="sp-unbox__node sp-unbox__node--domain">.com</div>
        <div class="sp-unbox__node sp-unbox__node--hosting">⌁</div>
        <div class="sp-unbox__node sp-unbox__node--email">@</div>
        <div class="sp-unbox__core">unbox<sup>™</sup></div>
      </div>
      <div class="sp-unbox__detail" id="sp-unbox-detail" role="tabpanel" aria-live="polite">
        <p class="sp-eyebrow" id="sp-unbox-detail-number">01 — Choose</p>
        <p id="sp-unbox-detail-copy">Select the extra products you need alongside your domain.</p>
      </div>
    </div>
  </div>
</section>

<script>
  const unboxSteps = document.querySelectorAll<HTMLButtonElement>("[data-unbox-step]");
  const detailNumber = document.querySelector<HTMLElement>("#sp-unbox-detail-number");
  const detailCopy = document.querySelector<HTMLElement>("#sp-unbox-detail-copy");
  const details: Record<string, { number: string; title: string; copy: string }> = {
    choose: { number: "01", title: "Choose", copy: "Select the extra products you need alongside your domain." },
    connect: { number: "02", title: "Connect", copy: "Bring everything together into one easily manageable solution." },
    configure: { number: "03", title: "Configure", copy: "Tailor your products and setup to meet your specific needs." },
    create: { number: "04", title: "Create", copy: "You’re done and ready to build, launch, and grow your ideas." },
  };

  unboxSteps.forEach((step) => {
    step.addEventListener("click", () => {
      const selected = step.dataset.unboxStep;
      if (!selected || !details[selected]) return;
      const detail = details[selected];
      unboxSteps.forEach((item) => item.setAttribute("aria-selected", String(item === step)));
      if (detailNumber) detailNumber.textContent = `${detail.number} — ${detail.title}`;
      if (detailCopy) detailCopy.textContent = detail.copy;
    });
  });
</script>

<style>
  .sp-unbox { background: var(--bg); }
  .sp-unbox__intro { max-width: 650px; }
  .sp-unbox__intro .sp-button { width: max-content; margin-top: var(--space-8); }
  .sp-unbox__story { display: grid; grid-template-columns: minmax(260px, .8fr) minmax(310px, 1.25fr); gap: clamp(40px, 10vw, 150px); align-items: center; margin-top: clamp(60px, 10vw, 140px); }
  .sp-unbox__steps { display: grid; border-top: 1px solid var(--border); }
  .sp-unbox__steps button { display: flex; align-items: center; gap: var(--space-4); padding: var(--space-5) 0; border: 0; border-bottom: 1px solid var(--border); background: transparent; color: var(--muted); text-align: left; transition: color var(--motion-fast) var(--ease-standard); }
  .sp-unbox__steps button:hover,
  .sp-unbox__steps button[aria-selected="true"] { color: var(--fg); }
  .sp-unbox__steps span { width: 30px; color: var(--accent); font-size: var(--text-xs); font-weight: 700; }
  .sp-unbox__steps strong { font-size: var(--text-xl); font-weight: 700; letter-spacing: var(--tracking-display); }
  .sp-unbox__visual { position: relative; min-height: 420px; overflow: hidden; border: 1px solid var(--border-soft); border-radius: var(--radius-lg); background: radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--accent), transparent 58%) 0 6%, transparent 28%), linear-gradient(135deg, var(--surface), var(--bg)); box-shadow: var(--elev-ring); }
  .sp-unbox__visual::before,
  .sp-unbox__visual::after { position: absolute; top: 50%; left: 50%; width: 68%; height: 1px; background: color-mix(in srgb, var(--fg), transparent 74%); content: ""; transform-origin: center; }
  .sp-unbox__visual::before { transform: translate(-50%, -50%) rotate(25deg); }
  .sp-unbox__visual::after { transform: translate(-50%, -50%) rotate(-25deg); }
  .sp-unbox__core,
  .sp-unbox__node { position: absolute; z-index: 2; display: grid; place-items: center; border: 1px solid var(--border); box-shadow: var(--elev-raised); }
  .sp-unbox__core { top: 50%; left: 50%; width: 124px; aspect-ratio: 1; border-radius: 50%; background: var(--accent); color: var(--accent-on); font-size: var(--text-lg); font-weight: 700; transform: translate(-50%, -50%); }
  .sp-unbox__core sup { font-size: 8px; }
  .sp-unbox__node { width: 68px; aspect-ratio: 1; border-radius: var(--radius-md); background: var(--surface-warm); color: var(--fg); font-size: var(--text-lg); font-weight: 700; }
  .sp-unbox__node--domain { top: 17%; left: 15%; }
  .sp-unbox__node--hosting { top: 17%; right: 15%; font-size: 34px; }
  .sp-unbox__node--email { right: 18%; bottom: 16%; }
  .sp-unbox__detail { grid-column: 2; margin-top: -100px; padding-left: clamp(0px, 7vw, 94px); }
  .sp-unbox__detail > p:last-child { max-width: 410px; margin: 0; color: var(--muted); font-size: var(--text-lg); line-height: 1.35; }
  @media (max-width: 760px) {
    .sp-unbox__story { grid-template-columns: 1fr; gap: var(--space-8); }
    .sp-unbox__visual { min-height: 350px; order: -1; }
    .sp-unbox__detail { grid-column: auto; margin-top: 0; padding-left: 0; }
  }
</style>
