<section class="sp-launchpad-section sp-section" id="launchpad">
  <div class="sp-shell">
    <div class="sp-launchpad-panel">
      <div class="sp-launchpad-panel__copy">
        <p class="sp-eyebrow">Launchpad</p>
        <h2 class="sp-display">Access everything, instantly</h2>
        <p>Get anywhere in Spaceship just by typing — through our Launchpad. Access accounts, products, and apps with tech that remembers and learns.</p>
        <button class="sp-button sp-button--secondary" type="button" data-launchpad-trigger>Open Launchpad <kbd>⌘ K</kbd></button>
      </div>
      <button class="sp-command-window" type="button" data-launchpad-trigger aria-label="Open the Launchpad command palette">
        <span><i>✦</i> Search Spaceship</span><kbd>⌘ K</kbd>
        <small>Domains <b>↗</b> &nbsp; Web Hosting <b>↗</b> &nbsp; Security Center <b>↗</b></small>
      </button>
    </div>
  </div>
</section>

<div class="sp-command-dialog" id="sp-command-dialog" role="dialog" aria-modal="true" aria-labelledby="sp-command-title" hidden>
  <div class="sp-command-dialog__backdrop" data-launchpad-close></div>
  <div class="sp-command-dialog__panel">
    <div class="sp-command-dialog__top">
      <span id="sp-command-title">Launchpad</span>
      <button class="sp-icon-button sp-button--secondary" type="button" data-launchpad-close aria-label="Close Launchpad">×</button>
    </div>
    <label class="sp-command-dialog__search"><span>✦</span><input type="search" placeholder="Search Spaceship" autofocus /><kbd>esc</kbd></label>
    <p>Suggested</p>
    <nav aria-label="Launchpad options">
      <a href="#domains" data-launchpad-close><span>◌</span> Domains <b>↗</b></a>
      <a href="#products" data-launchpad-close><span>⌁</span> Web Hosting <b>↗</b></a>
      <a href="#features" data-launchpad-close><span>◈</span> Security Center <b>↗</b></a>
      <a href="#alf" data-launchpad-close><span>✦</span> Ask Alf <b>↗</b></a>
    </nav>
  </div>
</div>

<script>
  const commandDialog = document.querySelector<HTMLElement>("#sp-command-dialog");
  const commandInput = commandDialog?.querySelector<HTMLInputElement>("input");
  const commandTriggers = document.querySelectorAll<HTMLButtonElement>("[data-launchpad-trigger]");
  const commandClosers = document.querySelectorAll<HTMLElement>("[data-launchpad-close]");

  const setCommandOpen = (open: boolean) => {
    if (!commandDialog) return;
    commandDialog.hidden = !open;
    document.body.classList.toggle("sp-palette-open", open);
    if (open) window.setTimeout(() => commandInput?.focus(), 0);
  };

  commandTriggers.forEach((trigger) => trigger.addEventListener("click", () => setCommandOpen(true)));
  commandClosers.forEach((closer) => closer.addEventListener("click", () => setCommandOpen(false)));
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      setCommandOpen(true);
    }
    if (event.key === "Escape") setCommandOpen(false);
  });
</script>

<style>
  .sp-launchpad-section { background: var(--bg); }
  .sp-launchpad-panel { min-height: 560px; display: grid; grid-template-columns: 1fr .95fr; align-items: center; gap: clamp(36px, 8vw, 120px); padding: clamp(32px, 7vw, 96px); overflow: hidden; border-radius: var(--radius-lg); background: var(--accent); color: var(--accent-on); }
  .sp-launchpad-panel__copy { max-width: 560px; }
  .sp-launchpad-panel__copy .sp-eyebrow { color: var(--accent-on); }
  .sp-launchpad-panel__copy > p:last-of-type { max-width: 500px; margin: var(--space-5) 0 0; font-size: var(--text-lg); line-height: 1.35; }
  .sp-launchpad-panel__copy .sp-button { width: max-content; margin-top: var(--space-8); border-color: color-mix(in srgb, var(--accent-on), transparent 60%); background: color-mix(in srgb, var(--accent-active), transparent 16%); }
  .sp-launchpad-panel kbd { border-color: color-mix(in srgb, var(--accent-on), transparent 68%); color: var(--accent-on); }
  .sp-command-window { min-height: 320px; display: grid; align-content: start; gap: var(--space-6); padding: var(--space-6); border: 1px solid color-mix(in srgb, var(--accent-on), transparent 72%); border-radius: var(--radius-md); background: color-mix(in srgb, var(--bg), transparent 8%); color: var(--fg); box-shadow: 0 28px 65px color-mix(in srgb, var(--accent-active), transparent 42%); text-align: left; transition: transform var(--motion-base) var(--ease-standard); }
  .sp-command-window:hover { transform: translateY(-5px) rotate(-1deg); }
  .sp-command-window > span { display: flex; align-items: center; justify-content: space-between; padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--surface-warm); color: var(--muted); }
  .sp-command-window i { color: var(--accent); font-style: normal; }
  .sp-command-window small { padding: var(--space-3); border-left: 1px solid var(--border); color: var(--muted); line-height: 2; }
  .sp-command-window b { color: var(--accent); }
  .sp-command-dialog { position: fixed; inset: 0; z-index: 120; display: grid; place-items: center; padding: var(--space-5); }
  .sp-command-dialog[hidden] { display: none; }
  .sp-command-dialog__backdrop { position: absolute; inset: 0; background: color-mix(in srgb, var(--bg), transparent 20%); backdrop-filter: blur(12px); }
  .sp-command-dialog__panel { position: relative; z-index: 1; width: min(100%, 620px); padding: var(--space-5); border: 1px solid var(--border); border-radius: var(--radius-md); background: var(--surface); box-shadow: var(--elev-raised); }
  .sp-command-dialog__top { display: flex; justify-content: space-between; align-items: center; margin-bottom: var(--space-5); font-weight: 700; }
  .sp-command-dialog__search { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); border: 1px solid var(--border); border-radius: var(--radius-sm); background: var(--bg); color: var(--accent); }
  .sp-command-dialog__search input { flex: 1; min-width: 0; border: 0; outline: 0; background: transparent; color: var(--fg); }
  .sp-command-dialog__search kbd { margin-left: auto; }
  .sp-command-dialog__panel > p { margin: var(--space-6) 0 var(--space-2); color: var(--muted); font-size: var(--text-xs); font-weight: 700; letter-spacing: .1em; text-transform: uppercase; }
  .sp-command-dialog nav { display: grid; }
  .sp-command-dialog nav a { display: flex; align-items: center; gap: var(--space-3); padding: var(--space-4); border-radius: var(--radius-sm); transition: background-color var(--motion-fast) var(--ease-standard); }
  .sp-command-dialog nav a:hover { background: var(--surface-warm); }
  .sp-command-dialog nav a span { color: var(--accent); }
  .sp-command-dialog nav a b { margin-left: auto; color: var(--muted); }
  @media (max-width: 760px) {
    .sp-launchpad-panel { min-height: 0; grid-template-columns: 1fr; }
    .sp-launchpad-panel__copy > p:last-of-type { font-size: var(--text-base); }
    .sp-command-window { min-height: 230px; }
  }
</style>
