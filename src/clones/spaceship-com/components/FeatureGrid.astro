---
const features = [
  { icon: "◌", title: "Domains List", copy: "For managing domain registrations and related settings, tools, and services." },
  { icon: "⌁", title: "Connection Manager", copy: "For setting up and managing how your products are connected together." },
  { icon: "✉", title: "Communication Center", copy: "For easily checking messages and managing your communication settings." },
  { icon: "▦", title: "Library", copy: "For access to every Spaceship product, service, and app on demand." },
  { icon: "↔", title: "Transfer Manager", copy: "For easy domain transfers and status checks that keep you up to speed." },
  { icon: "◇", title: "Security Center", copy: "For managing your safety settings, easy device tracking, and much more." },
];
---

<section class="sp-features sp-section" id="features">
  <div class="sp-shell">
    <div class="sp-features__intro">
      <p class="sp-eyebrow">Management suite</p>
      <h2 class="sp-display">Take total control</h2>
      <p class="sp-copy">Just some of the advanced management features you can deploy.</p>
    </div>
    <div class="sp-feature-grid">
      {features.map((feature) => (
        <a class="sp-feature-card" href="#faq">
          <span class="sp-feature-card__icon" aria-hidden="true">{feature.icon}</span>
          <span class="sp-feature-card__arrow" aria-hidden="true">↗</span>
          <h3>{feature.title}</h3>
          <p>{feature.copy}</p>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .sp-features { background: var(--surface); }
  .sp-features__intro { max-width: 640px; }
  .sp-feature-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--space-4); margin-top: clamp(48px, 7vw, 88px); }
  .sp-feature-card { position: relative; min-height: 260px; display: flex; flex-direction: column; padding: var(--space-6); overflow: hidden; border: 1px solid var(--border-soft); border-radius: var(--radius-md); background: var(--bg); box-shadow: var(--elev-ring); transition: background-color var(--motion-fast) var(--ease-standard), border-color var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard); }
  .sp-feature-card:hover { border-color: var(--border); background: var(--surface-warm); transform: translateY(-3px); }
  .sp-feature-card__icon { width: 48px; height: 48px; display: grid; place-items: center; border: 1px solid var(--border); border-radius: var(--radius-sm); color: var(--accent); font-size: var(--text-lg); font-weight: 700; }
  .sp-feature-card__arrow { position: absolute; top: var(--space-6); right: var(--space-6); color: var(--muted); transition: color var(--motion-fast) var(--ease-standard), transform var(--motion-fast) var(--ease-standard); }
  .sp-feature-card:hover .sp-feature-card__arrow { color: var(--accent); transform: translate(2px, -2px); }
  h3 { margin: auto 0 var(--space-2); font-size: var(--text-lg); font-weight: 700; letter-spacing: var(--tracking-display); line-height: 1.1; }
  .sp-feature-card p { margin: 0; color: var(--muted); font-size: var(--text-sm); line-height: 1.45; }
  @media (max-width: 850px) { .sp-feature-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 560px) { .sp-feature-grid { grid-template-columns: 1fr; } .sp-feature-card { min-height: 220px; } }
</style>
