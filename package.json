{
  "name": "ai-website-cloner-template",
  "version": "0.4.0",
  "private": true,
  "description": "Extract portable OpenDesign systems and rebuild pages with Astro by default",
  "type": "module",
  "author": "Juan Silva",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/juansilvadesign/ai-website-cloner-template.git"
  },
  "homepage": "https://github.com/juansilvadesign/ai-website-cloner-template#readme",
  "bugs": {
    "url": "https://github.com/juansilvadesign/ai-website-cloner-template/issues"
  },
  "keywords": [
    "claude-code",
    "website-clone",
    "reverse-engineering",
    "astro",
    "nextjs",
    "ai",
    "template",
    "design-system"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "astro build",
    "preview": "astro preview",
    "lint": "eslint \"src/**/*.{astro,js,mjs,ts}\" astro.config.mjs eslint.config.mjs",
    "typecheck": "astro check",
    "typecheck:scripts": "tsc --ignoreConfig --noEmit --strict --skipLibCheck --module NodeNext --moduleResolution NodeNext --target ES2022 --types node scripts/emit-design-system.ts scripts/validate-design-system.ts",
    "check": "npm run lint && npm run typecheck && npm run typecheck:scripts && npm run build",
    "eject": "node scripts/eject-clone.mjs",
    "check:design-system": "tsx scripts/validate-design-system.ts",
    "check:nextjs": "npm --prefix templates/nextjs run check",
    "check:nextjs-audit": "node scripts/check-nextjs-audit.mjs",
    "check:release": "npm run check && npm run check:design-system -- --brand psiativa && npm run check:nextjs"
  },
  "dependencies": {
    "astro": "^7.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@types/node": "^24.13.3",
    "@typescript-eslint/parser": "^8.65.0",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
